--- Протокол Месенжера Сохацького v2 для паб-саб брокерів на TLS
--- https://tonpa.guru/stream/2023/2023-08-07 CHAT ASN.1.htm

CHAT-v2 DEFINITIONS IMPLICIT TAGS ::=
BEGIN
    -- CHAT-v2 design direction
    --
    -- Архітектурна мета:
    --   1. CHATProtocol містить тільки transport-level packet types.
    --   2. Message описує тільки контент повідомлення.
    --   3. Event є єдиним каналом runtime-подій (ack/activity/state updates).
    --   4. Query є єдиним request/response механізмом.
    --   5. Domain сутності (Subscription, Person, Member, Conference, Roster, Inbox view)
    --      не повинні бути top-level packet types.
    --
    -- Цільова модель:
    --   state   -> окремі domain/resource типи
    --   command -> Query
    --   event   -> Event
    --
    -- Тобто одна семантика не повинна мати кілька паралельних wire-шляхів.

    IMPORTS ContentInfo FROM CryptographicMessageSyntax-2009
            CertificationRequest FROM PKCS-10
            Certificate FROM PKIX1Explicit-2009 ;

    Version ::= INTEGER  { v0(0), v1(1), v2(2), v3(3) }
    OS ::= ENUMERATED { apple (1), microsoft (2), google (3), ericsson (4), nokia (5), cisco (6) }

    -- 01 Authority (CA)

    Feature ::= SEQUENCE { id OCTET STRING, key OCTET STRING, value OCTET STRING, group OCTET STRING }
    AuthorityMethod ::= ENUMERATED { announce (0), enroll (1), authenticate (2), revoke (3), renew (4) }
    Authority ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       type AuthorityMethod,
       cert OCTET STRING,
       settings SEQUENCE OF feature Feature }

    -- 02 Message (MNESIA, SQLite)

    -- Message описує тільки саме повідомлення і його вміст.
    -- Event є уніфікованим типом для всіх подій (Ack + Activity).
    -- Такий поділ мінімізує розмір базових повідомлень і не змішує семантику.

    MessageType ::= ENUMERATED { normal (0), sys (1), reply (2), forward (3) }

    MessageFeed ::= CHOICE { private [1] Privatebox, chan [2] Streambox, mailbox [4] Mailbox, group [8] Groupbox }

    Message ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,

       -- базовий мінімум
       feed MessageFeed,
       payload ContentInfo,

       -- optional атрибути
       type MessageType OPTIONAL,
       linkId OCTET STRING OPTIONAL,
       files SEQUENCE OF fileId OCTET STRING OPTIONAL,
       mentioned SEQUENCE OF name OCTET STRING OPTIONAL
    }

    -- 03 Inbox Folder Queue (MNESIA, SQLite) /Mail /Chat

    Privatebox ::= SEQUENCE { address OCTET STRING }
    Streambox ::= SEQUENCE { channel OCTET STRING }
    Groupbox ::= SEQUENCE { channel OCTET STRING }
    Mailbox ::= SEQUENCE { channel OCTET STRING }

    InboxMethod ::= ENUMERATED { get (1), erase (2) }

    Inbox ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       type InboxMethod,
       feed MessageFeed,
       messages SEQUENCE OF message Message }

    InboxOp ::= ENUMERATED {
       get   (1),
       erase (2)
    }

    -- get/erase працюють у межах конкретного feed
    -- для обох операцій feed очікується
    InboxQueryRequest ::= SEQUENCE {
       op    InboxOp,
       feed  MessageFeed OPTIONAL
    }

    InboxItem ::= SEQUENCE {
       message Message
    }

    -- result повертає набір елементів inbox для feed (може бути пустим)
    InboxQueryResult ::= SEQUENCE {
       items SEQUENCE OF item InboxItem OPTIONAL
    }

    -- 04 Event (Ack + Activity fusion)
    --
    -- Event є єдиним каналом runtime-подій.
    -- Події групуються за family payload, без глобального плаского enum.
    -- Для простих family тип події задається локальним enum усередині payload.

    MessageEventType ::= ENUMERATED {
       received  (1),
       delivered (2),
       read      (3),
       edited    (4),
       deleted   (5),
       updated   (6)
    }

    MessageEvent ::= SEQUENCE {
       type       MessageEventType,
       messageId  OCTET STRING OPTIONAL,
       feed       MessageFeed OPTIONAL,
       actor      OCTET STRING OPTIONAL,
       timestamp  INTEGER OPTIONAL
    }

    PresenceEventType ::= ENUMERATED {
       online   (1),
       offline  (2),
       typing   (3)
    }

    PresenceEvent ::= SEQUENCE {
       type       PresenceEventType,
       feed       MessageFeed OPTIONAL,
       actor      OCTET STRING OPTIONAL,
       timestamp  INTEGER OPTIONAL
    }

    EventPayload ::= CHOICE {
       message   [1] MessageEvent,
       presence  [2] PresenceEvent
    }

    Event ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       payload EventPayload
    }
    
    -- Query є єдиним request/response шаром протоколу.
    -- Усі commands і state-запити повинні йти через Query.
    -- Payload уже розбитий на доменні family envelope.
    -- Внутрішні request/result payload типи тимчасово залишаються opaque
    -- до поступової типізації кожної family окремо.

    QueryType ::= ENUMERATED {
       get    (1),
       set    (2),
       result (3),
       error  (4)
    }

    Query ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,

       queryType QueryType,

       refId OCTET STRING OPTIONAL, -- request correlation id
       feed MessageFeed OPTIONAL,
       target OCTET STRING OPTIONAL, -- optional routing hint; domain target belongs in payload
       payload QueryPayload OPTIONAL, -- typed query family payload
       code INTEGER OPTIONAL
    }

    PresenceQueryRequest ::= OCTET STRING
    PresenceQueryResult  ::= OCTET STRING

    PersonQueryRequest ::= OCTET STRING
    PersonQueryResult  ::= OCTET STRING

    MemberQueryRequest ::= OCTET STRING
    MemberQueryResult  ::= OCTET STRING

    RosterQueryRequest ::= OCTET STRING
    RosterQueryResult  ::= OCTET STRING

    ConferenceQueryRequest ::= OCTET STRING
    ConferenceQueryResult  ::= OCTET STRING

    ModerationQueryRequest ::= OCTET STRING
    ModerationQueryResult  ::= OCTET STRING

    QueryPayload ::= CHOICE {
       subscription [1] SubscriptionQueryEnvelope,
       presence     [2] PresenceQueryEnvelope,
       person       [3] PersonQueryEnvelope,
       member       [4] MemberQueryEnvelope,
       roster       [5] RosterQueryEnvelope,
       conference   [6] ConferenceQueryEnvelope,
       inbox        [7] InboxQueryEnvelope,
       search       [8] SearchQueryEnvelope,
       moderation   [9] ModerationQueryEnvelope
    }

    SubscriptionQueryEnvelope ::= CHOICE {
       request [1] SubscriptionQueryRequest,
       result  [2] SubscriptionQueryResult
    }

    PresenceQueryEnvelope ::= CHOICE {
       request [1] PresenceQueryRequest,
       result  [2] PresenceQueryResult
    }

    PersonQueryEnvelope ::= CHOICE {
       request [1] PersonQueryRequest,
       result  [2] PersonQueryResult
    }

    MemberQueryEnvelope ::= CHOICE {
       request [1] MemberQueryRequest,
       result  [2] MemberQueryResult
    }

    RosterQueryEnvelope ::= CHOICE {
       request [1] RosterQueryRequest,
       result  [2] RosterQueryResult
    }

    ConferenceQueryEnvelope ::= CHOICE {
       request [1] ConferenceQueryRequest,
       result  [2] ConferenceQueryResult
    }

    InboxQueryEnvelope ::= CHOICE {
       request [1] InboxQueryRequest,
       result  [2] InboxQueryResult
    }

    ModerationQueryEnvelope ::= CHOICE {
       request [1] ModerationQueryRequest,
       result  [2] ModerationQueryResult
    }

    -- 05 Search (LDAP Search)

    SearchStatus ::= ENUMERATED { ok (0) }
    Criteria ::= ENUMERATED { equal (0), notequal (1), like (2) }
    Scope ::= ENUMERATED { profile (0), folder (1), contact (2), member (3), room (4), chat (5), message (6) }

    -- TODO кандидат на видалення
    Search ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       dn OCTET STRING,
       field OCTET STRING,
       value OCTET STRING,
       criteria Criteria,
       type Scope,
       status SearchStatus }

    SearchOp ::= ENUMERATED {
       execute (1),
       list    (2)
    }

    -- execute використовує field/value/criteria/type
    -- list допускає частковий фільтр або перегляд у межах scope/dn
    SearchQueryRequest ::= SEQUENCE {
       op       SearchOp,
       dn       OCTET STRING OPTIONAL,
       field    OCTET STRING OPTIONAL,
       value    OCTET STRING OPTIONAL,
       criteria Criteria OPTIONAL,
       type     Scope OPTIONAL
    }

    SearchItem ::= SEQUENCE {
       dn       OCTET STRING OPTIONAL,
       field    OCTET STRING OPTIONAL,
       value    OCTET STRING OPTIONAL,
       criteria Criteria OPTIONAL,
       type     Scope OPTIONAL
    }

    -- result повертає список знайдених елементів (може бути пустим)
    SearchQueryResult ::= SEQUENCE {
       items SEQUENCE OF item SearchItem OPTIONAL
    }

    SearchQueryEnvelope ::= CHOICE {
       request [1] SearchQueryRequest,
       result  [2] SearchQueryResult
    }

    -- 06 Subscription (зв'язок підписки між суб'єктом і ціллю)
    --
    -- Модель спрощена до факту зв'язку (actor -> target).
    -- Жодних статусів або presence тут більше немає.
    --
    -- Перенесення семантики:
    --
    -- Presence (online/offline/typing):
    --   → перенесено в Event
    --
    -- Lifecycle дії (request/confirm/ignore/ban/unban):
    --   → передаються через Event (як події)
    --   → або ініціюються через Query (type=set)
    --
    -- Бан:
    --   → не є частиною Subscription
    --   → є server-side policy (обмеження доступу)
    --   → встановлюється через Query і сигналізується через Event
    --
    -- Таким чином:
    --   Subscription = state (факт зв'язку)
    --   Event        = що сталося (події)
    --   Query        = як це змінити / отримати

    Subscription ::= SEQUENCE {
       actor  OCTET STRING,
       target OCTET STRING
    }

    -- get/create/remove очікують actor + target
    -- list допускає частковий фільтр
    SubscriptionQueryRequest ::= SEQUENCE {
       op     SubscriptionOp,
       actor  OCTET STRING OPTIONAL,
       target OCTET STRING OPTIONAL
    }

    SubscriptionOp ::= ENUMERATED {
       get    (1),
       list   (2),
       create (3),
       remove (4)
    }

    -- get/create/remove зазвичай повертають item
    -- list повертає items
    SubscriptionQueryResult ::= SEQUENCE {
       item   Subscription OPTIONAL,
       items  SEQUENCE OF subscription Subscription OPTIONAL
    }

    -- 07 Roster (LDAP /People, /Channels, /Topics and /Servers user sub-folders)

    -- Presence як snapshot-стан для roster/member.
    -- Runtime presence-події (online/offline/typing) передаються через Event.

    Presence ::= ENUMERATED { offline (1), online (2) }

    PersonStatus ::= ENUMERATED { req (1), auth (2), ignore (3), internal (4),
       friend (5), lastmsg (6), ban (7), banned (8), deleted (9), nonexised (10) }

    Person ::= SEQUENCE {
       id OCTET STRING,
       nickname OCTET STRING,
       avatar OCTET STRING,
       names SEQUENCE OF name OCTET STRING,
       phone OCTET STRING,
       surnames SEQUENCE OF name OCTET STRING,
       lastmsg Message,
       presence Presence,
       update INTEGER,
       created INTEGER,
       settings SEQUENCE OF feature Feature OPTIONAL,
       status PersonStatus }

    Server ::= SEQUENCE { service OCTET STRING, port INTEGER, host OCTET STRING }
    RosterStatus ::= ENUMERATED {
       get (1), create (2), del (3), remove (4), nick (5), search (6),
       contact (7), add (8), update (9), list (10), patch (11), lastmsg (12) }
    Roster ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       nickname OCTET STRING,
       keys SEQUENCE OF key OCTET STRING,
       people SEQUENCE OF contact Person,
       topics SEQUENCE OF room Conference,
       channels SEQUENCE OF room Conference,
       servers SEQUENCE OF server Server,
       update INTEGER,
       status RosterStatus }

    -- 08 Conference (RocksDB, Multi-user Conferences)

    MemberStatus ::= ENUMERATED { admin (1), member (2), removed (3), patch (4), owner (5) }
    Member ::= SEQUENCE {
       id OCTET STRING,
       nickname OCTET STRING,
       feed MessageFeed,
       feeds SEQUENCE OF feed OCTET STRING,
       phone OCTET STRING,
       avatar OCTET STRING,
       names SEQUENCE OF name OCTET STRING,
       surnames SEQUENCE OF name OCTET STRING,
       alias OCTET STRING,
       update INTEGER,
       settings SEQUENCE OF feature Feature,
       presence Presence,
       status MemberStatus }

    ConferenceType ::= ENUMERATED { group (1), channel (2), call (3) }
    ConferenceStatus ::= ENUMERATED { create (1), leave (2), add (3), remove (4), removed (5),
       join (6), joined (7), info (8), patch (9), get (10), delete (11), lastmsg (12), mute (13), unmute (14) }
    Conference ::= SEQUENCE {
       id OCTET STRING,
       vsn Version,
       session OCTET STRING,
       name OCTET STRING,
       links SEQUENCE OF link OCTET STRING,
       description OCTET STRING,
       settings SEQUENCE OF feature Feature,
       members SEQUENCE OF member Member,
       admins SEQUENCE OF member Member,
       data SEQUENCE OF fileId OCTET STRING OPTIONAL,
       type ConferenceType,
       tos OCTET STRING,
       unread INTEGER,
       mentions SEQUENCE OF contact INTEGER,
       lastmsg Message,
       update INTEGER,
       created INTEGER,
       status ConferenceStatus }

    -- 09 CHAT-v2 Protocol Entities

    CHATProtocol ::= CHOICE {
       authority [1] Authority,
       message   [2] Message,
       event     [4] Event,
       query     [5] Query
    }

    CHATMessage ::= SEQUENCE {
       no INTEGER,
       headers SEQUENCE OF header OCTET STRING,
       body CHATProtocol }

END