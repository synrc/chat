--- Протокол Месенжера Сохацького (Будда Протокол) v2 для паб-саб брокерів на TLS
--- https://tonpa.guru/stream/2023/2023-08-07%20CHAT%20ASN.1.htm
--- Верифікація протоколу для узгодженого порівняння з XMPP виконана Юрієм Масловським,
--- автором його першої імплементації для NYNJA.

CHAT-L2 DEFINITIONS IMPLICIT TAGS ::=
BEGIN
    -- CHAT-v2 design direction
    --
    -- Архітектурна мета:
    --   1. CHATProtocol містить тільки transport-level packet types.
    --   2. Message описує тільки контент повідомлення.
    --   3. Event є єдиним каналом runtime-подій (ack/activity/state updates).
    --   4. Query є єдиним request/response механізмом.
    --   5. Domain сутності (Subscription, Person, Member, Conference, Roster, Inbox view)
    --      не повинні бути top-level packet types.
    --
    -- Тобто одна семантика не повинна мати кілька паралельних wire-шляхів.

    IMPORTS ContentInfo FROM CryptographicMessageSyntax-2009
            CertificationRequest FROM PKCS-10
            Certificate FROM PKIX1Explicit-2009 ;

    Version ::= INTEGER  { v0(0), v1(1), v2(2), v3(3) }

    -- Version Semantics
    --
    --   * vsn визначає wire-версію конкретного повідомлення.
    --
    --   * Клієнт і сервер MAY підтримувати кілька версій протоколу.
    --
    -- Compatibility:
    --
    --   * Якщо отримана версія підтримується, повідомлення
    --     обробляється за правилами цієї версії.
    --
    --   * Якщо версія не підтримується, сервер SHOULD повертати:
    --
    --       Query(type=error, code=unsupportedVersion)
    --
    -- Forward compatibility:
    --
    --   * Невідомі extension-поля SHOULD ігноруватись.
    --
    --   * Розширення через "..." не повинні ламати сумісність
    --     зі старішими реалізаціями.

    Flavour ::= ENUMERATED { apple (1), microsoft (2), google (3), ericsson (4), nokia (5), cisco (6) }
    Binary  ::= OCTET STRING
    Continuation ::= OCTET STRING

    -- Session Semantics
    --
    -- Протокол розрізняє три рівні:
    --
    --   Identity: користувач
    --   Device: пристрій (телефон, браузер, десктоп)
    --   Session: runtime-екземпляр клієнта (запуск застосунку або вкладка)
    --
    -- Session представляє конкретний клієнтський інстанс.
    --
    -- Властивості:
    --
    --   * Один користувач MAY мати кілька device.
    --   * Один device MAY мати кілька session.
    --   * Session є незалежними одна від одної.
    --
    -- Важливо:
    --
    --   * Session НЕ є транспортним з'єднанням.
    --   * Session НЕ є користувачем.
    --   * Session переживає reconnect.
    --
    -- Життєвий цикл:
    --
    --   * Session створюється під час authenticate.
    --   * Session ідентифікується через session_id.
    --   * Session MAY бути відновлена після reconnect.
    --
    -- Використання:
    --
    --   * Поле session у Message/Event/Query/Authority означає
    --     контекст конкретного клієнтського інстансу.
    --
    -- Session Lifecycle Policy
    --
    --   * Session створюється тільки через Authority.authenticate.
    --
    --   * Session має життєвий цикл:
    --       - active
    --       - expired
    --       - revoked
    --
    --   * reconnect не створює нову session,
    --     а відновлює існуючу session за умови, що:
    --       - session існує
    --       - accessToken валідний
    --       - session не expired і не revoked
    --
    --   * renew не створює session,
    --     а лише перевидає accessToken через refreshToken.
    --
    --   * authenticate з refreshToken MAY:
    --       - відновити існуючу session
    --       - або створити нову session,
    --         якщо попередня session втрачена або expired
    --
    --   * revoke accessToken інвалідує конкретну session.
    --
    --   * revoke refreshToken MAY інвалідувати всі session,
    --     пов'язані з device/client.
    --
    --   * Session MAY мати server-side TTL і завершуватись
    --     після періоду неактивності.

    -- 01 Authority (CA)

    Feature ::= SEQUENCE { id Binary, key Binary, value Binary, group Binary }
    -- Feature / Capability Negotiation
    --
    --   * Feature використовується для опису можливостей клієнта і сервера.
    --
    --   * Feature.id визначає тип capability.
    --
    --   * key/value можуть використовуватись для параметризації feature.
    --
    -- Usage:
    --
    --   * Сервер MAY передавати список підтримуваних feature
    --     через Authority.settings (announce / authenticate).
    --
    --   * Клієнт MAY передавати підтримувані feature
    --     через AuthRequest (через settings або окреме поле).
    --
    -- Negotiation:
    --
    --   * Клієнт і сервер повинні використовувати тільки
    --     перетин підтримуваних feature.
    --
    --   * Невідомі feature повинні ігноруватись.
    --
    -- Приклади:
    --
    --   * typingOptimized
    --   * readCursor
    --   * batchTransport
    --   * federationRouting

    AuthorityMethod ::= ENUMERATED { announce (0), enroll (1), authenticate (2), revoke (3), renew (4), ... }
    -- Authority Method Semantics
    --
    -- announce:
    --   * server capabilities / bootstrap metadata
    --
    -- enroll:
    --   * первинна реєстрація device/client або сертифіката
    --
    -- authenticate:
    --   * створює нову session
    --   * або відновлює існуючу session через session + accessToken
    --
    -- renew:
    --   * перевидає accessToken через refreshToken
    --   * може також повертати новий refreshToken
    --
    -- revoke:
    --   * інвалідує accessToken конкретної session
    --   * або всі session, пов'язані з device/client

    -- AuthRequest використовується для:
    --   - первинної аутентифікації
    --   - reconnect існуючої session
    --   - renew access token через refresh token
    -- Token Scope
    --
    --   * accessToken прив'язаний до конкретної session
    --     і використовується для transport authorization / reconnect.
    --
    --   * refreshToken прив'язаний до device/client
    --     і використовується для перевидачі accessToken.
    --
    --   * Один device MAY мати кілька session.
    --
    --   * Відкликання accessToken повинно впливати тільки
    --     на відповідну session.
    --
    --   * Відкликання refreshToken може інвалідовувати
    --     всі session, пов'язані з device/client.
    --
    -- Version Negotiation
    --
    --   * Під час authenticate клієнт MAY передати supportedVsn:
    --     перелік підтримуваних wire-версій.
    --
    --   * Сервер MAY вибрати сумісну версію і повернути її
    --     в AuthAnswer.selectedVsn.
    --
    --   * Якщо спільної версії немає, сервер SHOULD повертати:
    --
    --       Query(type=error, code=unsupportedVersion)
    AuthRequest ::= SEQUENCE {
       accessToken  [0] Binary OPTIONAL,
       refreshToken [1] Binary OPTIONAL,
       device       [2] Binary OPTIONAL,
       client       [3] Binary OPTIONAL,
       phone        [4] Binary OPTIONAL,
       sms          [5] Binary OPTIONAL,
       os           [6] INTEGER OPTIONAL,
       services     [7] INTEGER OPTIONAL,
       push         [8] Binary OPTIONAL,
       supportedVsn [9] SEQUENCE OF version Version OPTIONAL,
       ...
    }

    -- AuthAnswer повертає токени та параметри session
    -- після authenticate / renew.
    -- accessToken авторизує конкретну session.
    -- refreshToken дозволяє перевидачу accessToken для device/client.
    AuthAnswer ::= SEQUENCE {
       accessToken  [0] Binary OPTIONAL,
       refreshToken [1] Binary OPTIONAL,
       device       [2] Binary OPTIONAL,
       client       [3] Binary OPTIONAL,
       services     [4] INTEGER OPTIONAL,
       selectedVsn  [5] Version OPTIONAL,
       ...
    }

    Authority ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       type AuthorityMethod,
       request [0] AuthRequest OPTIONAL,
       result  [1] AuthAnswer OPTIONAL,
       cert ANY OPTIONAL,
       settings SEQUENCE OF feature Feature OPTIONAL,
        ... }

    -- 02 Message (MNESIA, SQLite)

    -- Message описує тільки саме повідомлення і його вміст.
    -- Event є уніфікованим типом для всіх подій (Ack + Activity).
    -- Такий поділ мінімізує розмір базових повідомлень і не змішує семантику.

    MessageType ::= ENUMERATED { normal (0), sys (1), reply (2), forward (3), ... }

    MessageFeed ::= CHOICE { private [1] Privatebox, chan [2] Streambox, mailbox [4] Mailbox, group [8] Groupbox, ... }

    File ::= SEQUENCE {
       id Binary,
       mime Binary,
       payload ContentInfo,
       parentid Binary }

    -- Idempotency and Ordering
    --
    -- Idempotency:
    --
    --   - Message.id повинен бути глобально унікальним.
    --   - Повторна відправка Message з тим самим id не повинна створювати дублі.
    --
    -- Ordering:
    --
    --   - Порядок повідомлень гарантується тільки в межах feed.
    --   - Глобальний порядок між різними session не гарантується.
    --
    -- Event ordering:
    --
    --   - Події можуть приходити не в строгому порядку.
    --   - Клієнт повинен обробляти можливу перестановку подій.
    --
    -- Важливо:
    --
    --   - Протокол допускає дублікати і reorder.
    --   - Клієнт і сервер повинні бути ідемпотентними.
    --
    -- Event Idempotency:
    --
    --   - Повторна доставка Event з тим самим id не повинна
    --     створювати дублікати побічних ефектів.
    --
    --   - seq використовується для впорядкування і recovery,
    --     але не замінює Event.id як ідентифікатор події.

    Message ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       feed MessageFeed,
       payload ContentInfo,
       type MessageType OPTIONAL,
       link Binary OPTIONAL,
       files [0] SEQUENCE OF file File OPTIONAL,
       mentioned [1] SEQUENCE OF name Binary OPTIONAL,
       ...
    }

    -- 03 Inbox Folder Queue (MNESIA, SQLite) /Mail /Chat
    -- XMPP відповідність:
    --
    --   inbox / message retrieval:
    --     → XEP-0313 (Message Archive Management)
    --
    -- Зауваження:
    --
    --   У XMPP це окремий extension.
    --   Тут це частина core Query моделі.
    --

    Privatebox ::= SEQUENCE { address Binary }
    Streambox ::= SEQUENCE { channel Binary }
    Groupbox ::= SEQUENCE { channel Binary }
    Mailbox ::= SEQUENCE { channel Binary }

    InboxMethod ::= ENUMERATED { get (1), erase (2), ...}

    Inbox ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       type InboxMethod,
       feed MessageFeed,
       messages [0] SEQUENCE OF message Message OPTIONAL,
        ... }

    InboxOp ::= ENUMERATED {
       get   (1),
       erase (2),
       ...
    }

    -- get/erase працюють у межах конкретного feed
    -- для обох операцій feed очікується
    InboxQuery ::= SEQUENCE {
       op    InboxOp,
       feed  [0] MessageFeed OPTIONAL,
       ...
    }

    InboxItem ::= SEQUENCE {
       message Message
    }

    -- result повертає набір елементів inbox для feed (може бути пустим)
    InboxAnswer ::= SEQUENCE {
       items [0] SEQUENCE OF item InboxItem OPTIONAL,
       ...
    }

    -- 04 Event (Ack + Activity fusion)
    --
    -- Event є єдиним каналом runtime-подій.
    -- Події групуються за family payload, без глобального плаского enum.
    -- Для простих family тип події задається локальним enum усередині payload.

    -- XMPP відповідність:
    --
    --   delivered / received / read:
    --     → XEP-0184 (Message Delivery Receipts)
    --
    --   deleted (message retraction):
    --     → XEP-0425 (Message Retraction)
    --
    --   edited / updated:
    --     → XEP-0308 (Last Message Correction)
    --

    MessageEventType ::= ENUMERATED {
       received  (1),
       delivered (2),
       read      (3),
       edited    (4),
       deleted   (5),
       updated   (6), ...}

    -- Delivery and Read Semantics
    --
    -- Події доставки і читання є session-рівня.
    --
    -- delivered:
    --   означає, що повідомлення доставлено конкретній session.
    --
    -- read:
    --   означає, що повідомлення прочитано конкретною session.
    --
    -- Multi-device:
    --
    --   - Один користувач може мати кілька session.
    --   - delivered/read можуть генеруватись окремо для кожної session.
    --
    -- Агрегація:
    --
    --   - Узагальнення до рівня device або користувача
    --     виконується сервером і не є частиною протоколу.
    --
    -- Read cursor:
    --
    --   - Read події можуть інтерпретуватись як cursor (позиція)
    --     у межах feed.
    --
    --   - Кожна session може мати власний read cursor.
    --
    --   - Unread визначається як різниця між поточним seq feed
    --     і read cursor.
    --
    -- Зауваження:
    --
    --   * Події read/delivered є session-рівня,
    --     але передаються через спільний stream feed.
    --
    --   * Протокол використовує cursor-based модель читання.
    --
    --   * Read визначається як позиція (seq), а не як набір messageId.
    --
    --   * Деталізовані read receipts (per message / per user)
    --     не є частиною базової моделі.
    --
    -- Event Throttling / Aggregation
    --
    --   * High-frequency події (typing, presence, read)
    --     можуть генерувати значне навантаження.
    --
    -- Typing:
    --
    --   * Сервер SHOULD обмежувати частоту typing подій.
    --
    --   * Рекомендовано:
    --       - не частіше ніж 1 подія на 2–3 секунди
    --
    --   * Повторні typing події в межах цього інтервалу
    --     MAY ігноруватись або агрегуватись.
    --
    -- Presence:
    --
    --   * Часті зміни (online/offline) SHOULD debounce-итись.
    --
    --   * Сервер MAY:
    --       - відкладати зміни на короткий інтервал
    --       - об'єднувати швидкі переходи станів
    --
    -- Read:
    --
    --   * Read події SHOULD агрегуватись до cursor-моделі:
    --       - передається тільки останній seq (last read)
    --
    --   * Сервер MAY не передавати кожну read подію окремо.
    --
    -- Delivery:
    --
    --   * delivered події MAY агрегуватись або пропускатись,
    --     якщо клієнт не потребує детальної інформації.
    --
    -- Важливо:
    --
    --   * Throttling і aggregation не змінюють семантику стану,
    --     а лише оптимізують доставку подій.
    --   * typing інтерпретується як короткоживучий стан,
    --     а не як кожна окрема подія натискання клавіші.

    MessageEvent ::= SEQUENCE {
       type       MessageEventType,
       messageId  [0] Binary OPTIONAL,
       feed       [1] MessageFeed OPTIONAL,
       actor      [2] Binary OPTIONAL,
       timestamp  [3] INTEGER OPTIONAL,
       ...
    }

    -- XMPP відповідність:
    --
    --   online / offline:
    --     → RFC 3921 (Presence)
    --
    --   typing:
    --     → XEP-0085 (Chat State Notifications)
    --

    PresenceEventType ::= ENUMERATED {
       online   (1),
       offline  (2),
       typing   (3), ...}

    PresenceEvent ::= SEQUENCE {
       type       PresenceEventType,
       feed       [0] MessageFeed OPTIONAL,
       actor      [1] Binary OPTIONAL,
       timestamp  [2] INTEGER OPTIONAL,
       ...
    }

    EventPayload ::= CHOICE {
       message   [1] MessageEvent,
       presence  [2] PresenceEvent
    }

    -- Sequencing
    --
    -- Події мають порядок у межах feed.
    --
    --   * seq є монотонно зростаючим у межах feed.
    --
    -- Session:
    --
    --   * session зберігає свою позицію (last_seq) у feed.
    --
    -- Використання:
    --
    --   * reconnect і recovery
    --   * replay подій
    --   * виявлення пропусків
    --
    -- Важливо:
    --
    --   * seq НЕ є глобальним.
    --   * seq визначений тільки в межах feed.
    --
    -- Event Consistency Model
    --
    --   * Події можуть:
    --       - приходити поза порядком
    --       - дублюватись
    --       - приходити із затримкою
    --
    --   * Протокол не гарантує causal ordering між подіями.
    --
    -- Conflict Resolution:
    --
    --   * Для подій, що змінюють стан (edited, updated, deleted),
    --     застосовується last-write-wins на основі timestamp.
    --
    --   * delete має пріоритет над edit/update:
    --       - якщо message видалено, подальші edit/update
    --         не повинні відновлювати його.
    --
    --   * Повторна доставка подій не повинна змінювати стан
    --     (ідемпотентність).
    --
    -- Client Requirements:
    --
    --   * Клієнт повинен:
    --       - обробляти дублікати подій
    --       - коректно обробляти reorder
    --       - виконувати reconciliation стану
    --
    --   * Клієнт не повинен покладатися на порядок доставки.
    --
    -- Зауваження:
    --
    --   * seq гарантує порядок replay,
    --     але не гарантує causal consistency.
    --
    --   * Для складних сценаріїв (collaborative editing)
    --     можуть знадобитись CRDT або version vectors
    --     (поза межами базового протоколу).

    Event ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       seq INTEGER,
       payload EventPayload,
       ...
    }

    -- Query є єдиним request/response шаром протоколу.
    -- Усі commands і state-запити повинні йти через Query.
    -- Payload уже розбитий на доменні family envelope.
    -- Внутрішні request/result payload типи тимчасово залишаються opaque
    -- до поступової типізації кожної family окремо.

    -- Reconnect Semantics
    --
    -- Транспортне зєднання може перериватись і відновлюватись.
    --
    -- Session:
    --
    --   - Session залишається валідною при reconnect.
    --   - Клієнт SHOULD повторно використовувати існуючу session.
    --
    -- Доставка подій:
    --
    --   - Після reconnect клієнт MAY отримати пропущені події.
    --   - Механізм відновлення (replay / fetch) реалізується через Query.
    --
    -- Важливо:
    --
    --   - Протокол не гарантує доставку всіх подій без повторного запиту.
    --   - Клієнт повинен бути готовий до втрати частини історії подій.
    --
    -- Recovery:
    --
    --   - Клієнт повинен зберігати останній отриманий seq.
    --
    --   - Після reconnect клієнт виконує Query для отримання подій
    --     починаючи з відомого seq.
    --
    --   - Сервер повертає події з seq > last_seq.
    --
    --   - Пропущені події відновлюються через цей механізм.
    --
    -- Offline:
    --
    --   - Офлайн режим не є окремою концепцією протоколу.
    --
    --   - Пропущені події відновлюються через seq (Event replay).
    --
    --   - У випадку втрати історії (gap) використовується Query (Inbox).
    --
    -- Retention and Gap Handling
    --
    --   * Сервер може обмежувати збереження подій у feed (retention).
    --
    --   * Якщо клієнт запитує after, який менший за мінімальний
    --     доступний seq, виникає gap (втрата частини історії).
    --
    -- Gap Detection:
    --
    --   * У випадку gap сервер SHOULD повертати:
    --
    --       Query(type=error, code=gapDetected)
    --
    --   * Це означає, що частина історії подій недоступна.
    --
    -- Client Behavior:
    --
    --   * Клієнт повинен виконати повний sync через:
    --       - Inbox Query
    --       - або інші view-запити
    --
    --   * Клієнт НЕ повинен припускати повноту даних,
    --     якщо seq має розрив.
    --
    -- Важливо:
    --
    --   * Event replay гарантує тільки partial recovery.
    --
    --   * Повна консистентність відновлюється через snapshot (Inbox).
    --
    -- Delivery Guarantees
    --
    --   * Базова модель доставки для Message і Event є at-least-once.
    --
    --   * Протокол допускає повторну доставку пакетів після retry
    --     або reconnect.
    --
    --   * Message і Event повинні бути ідемпотентними:
    --       - Message: через унікальний Message.id
    --       - Event: через Event.id і/або seq у межах feed
    --
    --   * received / delivered / read є application-level подіями
    --     і не означають exact-once гарантії transport-рівня.
    --
    --   * Exactly-once не є ціллю базової моделі протоколу.

    -- XMPP відповідність:
    --
    --   Query (request/response):
    --     → XEP-0004 (Data Forms)
    --     → XEP-0030 (Service Discovery)
    --
    -- Зауваження:
    --
    --   У XMPP request/response розподілений по різних stanza.
    --   У даному протоколі він уніфікований через Query.
    --


    QueryType ::= ENUMERATED {
       get    (1),
       set    (2),
       result (3),
       error  (4), ...}

    QueryError ::= ENUMERATED {
       badRequest          (1),
       unauthorized        (2),
       forbidden           (3),
       notFound            (4),
       conflict            (5),
       unsupportedVersion  (6),
       gapDetected         (7),
       rateLimited         (8),
       internalError       (9),
       unavailable         (10),
       ...
    }

    -- Query Error Semantics
    --
    --   * Query(type=error) використовується для повернення
    --     типізованої помилки request/response рівня.
    --
    --   * code визначає категорію помилки.
    --
    -- Retryable:
    --
    --   * unavailable
    --   * rateLimited
    --
    -- Recoverable with client action:
    --
    --   * unauthorized       -> renew / authenticate
    --   * unsupportedVersion -> fallback version
    --   * gapDetected        -> full sync через Inbox / view Query
    --
    -- Fatal for request:
    --
    --   * badRequest
    --   * forbidden
    --   * notFound
    --   * conflict

    Query ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       queryType QueryType,
       ref [0] Binary OPTIONAL, -- request correlation id
       feed [1] MessageFeed OPTIONAL,
       target [2] Binary OPTIONAL, -- optional routing hint; domain target belongs in payload
       payload [3] QueryPayload OPTIONAL, -- typed query family payload
       code [4] QueryError OPTIONAL,
       limit    [5] INTEGER OPTIONAL,
       continue [6] Continuation OPTIONAL,
       ...
    }

    QueryPayload ::= CHOICE {
       subscription [1] SubscriptionCore,
       presence     [2] PresenceCore,
       person       [3] PersonCore,
       roster       [4] RosterCore,
       member       [5] MemberExtension,
       conference   [6] ConferenceExtension,
       moderation   [7] ModerationExtension,
       inbox        [8] InboxExtension,
       search       [9] SearchExtension,
       bpe          [10] ProcessExtension,
       kvs          [11] StorageExtension,
       mail         [12] MailExtension, -- X.420
       event        [13] EventCore,
       ...
    }

    ProcessExtension ::= CHOICE { request [1] Binary, result [2] Binary }
    StorageExtension ::= CHOICE { request [1] Binary, result [2] Binary }
    MailExtension    ::= CHOICE { request [1] Binary, result [2] Binary }

    SubscriptionCore ::= CHOICE {
       request [1] SubscriptionQuery,
       result  [2] SubscriptionAnswer
    }

    PresenceCore ::= CHOICE {
       request [1] PresenceQuery,
       result  [2] PresenceAnswer
    }

    PersonCore ::= CHOICE {
       request [1] PersonQuery,
       result  [2] PersonAnswer
    }

    MemberExtension ::= CHOICE {
       request [1] MemberQuery,
       result  [2] MemberAnswer
    }

    InboxExtension ::= CHOICE {
       request [1] InboxQuery,
       result  [2] InboxAnswer
    }

    -- Pagination / Streaming (view queries)
    --
    --   * Для snapshot/view даних (roster, members, search, conference)
    --     використовується continuation-based pagination.
    --
    --   * limit задає максимальний розмір сторінки.
    --
    --   * continue є opaque token, який визначає позицію
    --     у результаті запиту.
    --
    --   * Сервер MAY повертати:
    --       - continue: token для наступної сторінки
    --       - hasMore: ознаку наявності додаткових даних
    --
    --   * Клієнт не повинен інтерпретувати continuation token.
    --
    --   * Pagination не гарантує snapshot isolation:
    --       - дані можуть змінюватись між сторінками
    --       - можливі дублікати або пропуски
    --
    --   * Для повної консистентності клієнт може виконати
    --     повторний повний запит.

    -- Event Core (recovery / replay)
    --
    -- Події зберігаються як спільний stream у межах feed.
    --
    -- Sequencing:
    --
    --   * seq визначений у межах feed і є монотонно зростаючим.
    --
    -- Session:
    --
    --   * Кожна session окремо зберігає свою позицію (last_seq) у feed.
    --   * Recovery виконується від імені конкретної session.
    --
    -- Recovery:
    --
    --   * Клієнт виконує Query з параметром after = last_seq.
    --   * Сервер повертає події з seq > after.
    --
    -- Важливо:
    --
    --   * Події є спільними для всіх session у межах feed.
    --   * Позиція (last_seq) є індивідуальною для кожної session.
    --   * Сервер не веде окремі черги подій на session.

    EventQuery ::= SEQUENCE {
       after [0] INTEGER OPTIONAL,
       limit [1] INTEGER OPTIONAL,
       ...
    }

    -- Event Pagination / Streaming
    --
    --   * after задає нижню межу replay:
    --       сервер повертає події з seq > after.
    --
    --   * limit задає максимальну кількість подій у відповіді.
    --
    --   * Якщо відповідь обрізана, сервер MAY повернути:
    --       - nextAfter: останній seq у поточній сторінці
    --       - hasMore: ознаку наявності наступної сторінки
    --
    --   * Клієнт може продовжити читання, використовуючи
    --     nextAfter як нове значення after.
    EventAnswer ::= SEQUENCE {
       events     [0] SEQUENCE OF event Event OPTIONAL,
       nextAfter  [1] INTEGER OPTIONAL,
       hasMore    [2] BOOLEAN OPTIONAL,
       ...
    }

    EventCore ::= CHOICE {
       request [1] EventQuery,
       result  [2] EventAnswer
    }

    -- 05 Search (LDAP Search)

    SearchStatus ::= ENUMERATED { ok (0), ...}
    Criteria ::= ENUMERATED { equal (0), notequal (1), like (2), ...}
    Scope ::= ENUMERATED { profile (0), folder (1), contact (2), member (3), room (4), chat (5), message (6), ...}

    SearchOp ::= ENUMERATED {
       execute (1),
       list    (2),
       ...
    }

    -- execute використовує field/value/criteria/type
    -- list допускає частковий фільтр або перегляд у межах scope/dn
    SearchQuery ::= SEQUENCE {
       op       SearchOp,
       dn       [0] Binary OPTIONAL,
       field    [1] Binary OPTIONAL,
       value    [2] Binary OPTIONAL,
       criteria [3] Criteria OPTIONAL,
       type     [4] Scope OPTIONAL,
       ...
    }

    SearchItem ::= SEQUENCE {
       dn       [0] Binary OPTIONAL,
       field    [1] Binary OPTIONAL,
       value    [2] Binary OPTIONAL,
       criteria [3] Criteria OPTIONAL,
       type     [4] Scope OPTIONAL
    }

    -- result повертає список знайдених елементів (може бути пустим)
    SearchAnswer ::= SEQUENCE {
       items     [0] SEQUENCE OF item SearchItem OPTIONAL,
       continue  [1] Continuation OPTIONAL,
       hasMore   [2] BOOLEAN OPTIONAL,
       ...
    }

    SearchExtension ::= CHOICE {
       request [1] SearchQuery,
       result  [2] SearchAnswer
    }

    -- 06 Subscription (зв'язок підписки між суб'єктом і ціллю)
    --
    -- Модель спрощена до факту зв'язку (actor -> target).
    -- Жодних статусів або presence тут більше немає.
    --
    -- Перенесення семантики:
    --
    -- Presence (online/offline/typing):
    --   → перенесено в Event
    --
    -- Lifecycle дії (request/confirm/ignore/ban/unban):
    --   → передаються через Event (як події)
    --   → або ініціюються через Query (type=set)
    --
    -- Бан:
    --   → не є частиною Subscription
    --   → є server-side policy (обмеження доступу)
    --   → встановлюється через Query і сигналізується через Event
    --
    -- Таким чином:
    --   Subscription = state (факт зв'язку)
    --   Event        = що сталося (події)
    --   Query        = як це змінити / отримати

    -- XMPP відповідність:
    --
    --   subscription (actor → target):
    --     → RFC 3921 (Roster + Presence Subscriptions)
    --
    -- Зауваження:
    --
    --   У XMPP subscription і presence lifecycle змішані.
    --   У даному протоколі:
    --     - Subscription = лише факт зв'язку
    --     - Lifecycle події → Event
    --     - Команди → Query
    --

    Subscription ::= SEQUENCE {
       actor  Binary,
       target Binary,
       ...
    }

    -- get/create/remove очікують actor + target
    -- list допускає частковий фільтр
    SubscriptionQuery ::= SEQUENCE {
       op     SubscriptionOp,
       actor  [0] Binary OPTIONAL,
       target [1] Binary OPTIONAL,
       ...
    }

    SubscriptionOp ::= ENUMERATED {
       get    (1),
       list   (2),
       create (3),
       remove (4),
       ...
    }

    -- get/create/remove зазвичай повертають item
    -- list повертає items
    SubscriptionAnswer ::= SEQUENCE {
       item   [0] Subscription OPTIONAL,
       items  [1] SEQUENCE OF subscription Subscription OPTIONAL,
       ...
    }

    -- 07 Roster (LDAP /People, /Channels, /Topics and /Servers user sub-folders)

    -- Presence як snapshot-стан для roster/member.
    -- Runtime presence-події (online/offline/typing) передаються через Event.

    Presence ::= ENUMERATED { offline (1), online (2), ... }

    PresenceOp ::= ENUMERATED {
       get  (1),
       list (2), ...
    }

    -- get зазвичай очікує actor
    -- list допускає actor і/або feed як фільтр вибірки
    -- feed задає контекст (якщо presence залежить від feed)
    PresenceQuery ::= SEQUENCE {
       op     PresenceOp,
       actor  [0] Binary OPTIONAL,
       feed   [1] MessageFeed OPTIONAL,
       ...
    }

    PresenceItem ::= SEQUENCE {
       actor     Binary,
       presence  Presence
    }

    -- get зазвичай повертає item
    -- list повертає items (може бути пустим)
    PresenceAnswer ::= SEQUENCE {
       item   [0] PresenceItem OPTIONAL,
       items  [1] SEQUENCE OF item PresenceItem OPTIONAL,
       ...
    }


    -- PersonStatus описує лише стан самого profile/state запису.
    -- Relation, lifecycle і moderation більше не живуть у Person:
    --   req/auth/ignore/friend -> Subscription / Event
    --   ban/banned             -> ModerationQuery / Event
    PersonStatus ::= ENUMERATED {
       active      (1),
       deleted     (2),
       nonexistent (3), ...
    }

    -- lastmsg не є частиною Person state.
    -- View-дані повинні передаватися через Query (Inbox/Search) або Event.
    Person ::= SEQUENCE {
       id Binary,
       nickname Binary,
       avatar Binary,
       names SEQUENCE OF name Binary,
       phone Binary,
       surnames SEQUENCE OF name Binary,
       presence Presence,
       update INTEGER,
       created INTEGER,
       settings SEQUENCE OF feature Feature OPTIONAL,
       status PersonStatus,
       ...
    }

    PersonOp ::= ENUMERATED {
       get    (1),
       list   (2),
       update (3),
       remove (4), ...
    }

    -- get/remove очікують id
    -- update використовує поля профілю
    -- list допускає частковий фільтр

    PersonQuery ::= SEQUENCE {
       op   PersonOp,

       id   [0] Binary OPTIONAL,
       name [1] Binary OPTIONAL,
       ...
    }

    PersonItem ::= SEQUENCE {
       id       Binary,
       nickname Binary,
       presence Presence,
       status   PersonStatus
    }

    -- get/update зазвичай повертають item
    -- list повертає items

    PersonAnswer ::= SEQUENCE {
       item   [0] PersonItem OPTIONAL,
       items  [1] SEQUENCE OF item PersonItem OPTIONAL,
       ...
    }

    Server ::= SEQUENCE { service Binary, port INTEGER, host Binary }

    -- RosterStatus описує лише стан roster як ресурсу.
    -- Command, mutation і lookup більше не живуть у Roster:
    --   get/create/del/remove/add/update/list/patch -> Query
    --   nick/search/contact/lastmsg                 -> Query / view

    RosterStatus ::= ENUMERATED {
       active   (1),
       archived (2),
       deleted  (3), ...
    }

    -- Roster є агрегованим snapshot/view ресурсом.
    -- Операції над roster передаються через Query.
    -- Runtime-події не живуть у Roster як моделі.

    -- XMPP відповідність:
    --
    --   roster:
    --     → RFC 3921 (Roster Management)
    --
    -- Зауваження:
    --
    --   У даному протоколі roster є snapshot/view ресурсом,
    --   а не джерелом runtime-подій.
    --

    Roster ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       nickname Binary,
       keys SEQUENCE OF key Binary,
       people SEQUENCE OF contact Person,
       topics SEQUENCE OF room Conference,
       channels SEQUENCE OF room Conference,
       servers SEQUENCE OF server Server,
       update INTEGER,
       status RosterStatus, ... }

    RosterOp ::= ENUMERATED {
       get  (1),
       list (2), ...
    }

    -- get зазвичай очікує id
    -- list допускає частковий фільтр

    RosterQuery ::= SEQUENCE {
       op   RosterOp,
       id   [0] Binary OPTIONAL,
       name [1] Binary OPTIONAL,
       ...
    }

    RosterItem ::= SEQUENCE {
       id       Binary,
       nickname Binary,
       status   RosterStatus
    }

    -- get зазвичай повертає item
    -- list повертає items
    RosterAnswer ::= SEQUENCE {
       item      [0] RosterItem OPTIONAL,
       items     [1] SEQUENCE OF item RosterItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL,
       ...
    }

    RosterCore ::= CHOICE {
       request [1] RosterQuery,
       result  [2] RosterAnswer
    }

    ModerationOp ::= ENUMERATED {
       ban    (1),
       unban  (2),
       list   (3), ...
    }

    -- ban/unban очікують actor + target
    -- list повертає список обмежень

    ModerationQuery ::= SEQUENCE {
       op     ModerationOp,
       actor  [0] Binary OPTIONAL,
       target [1] Binary OPTIONAL,
       ...
    }

    ModerationItem ::= SEQUENCE {
       actor   Binary,
       target  Binary
    }

    -- ban/unban зазвичай повертають item
    -- list повертає items

    ModerationAnswer ::= SEQUENCE {
       item   [0] ModerationItem OPTIONAL,
       items  [1] SEQUENCE OF item ModerationItem OPTIONAL,
       ...
    }

    ModerationExtension ::= CHOICE {
       request [1] ModerationQuery,
       result  [2] ModerationAnswer
    }

    -- 08 Conference (RocksDB, Multi-user Conferences)

    -- MemberStatus описує лише роль учасника в конференції.
    -- Lifecycle і mutation більше не живуть у Member:
    --   removed        -> Event / Query
    --   patch/update   -> Query
    MemberStatus ::= ENUMERATED {
       member (1),
       admin  (2),
       owner  (3), ...}

    Member ::= SEQUENCE {
       id Binary,
       nickname Binary,
       feed MessageFeed,
       feeds SEQUENCE OF feed Binary,
       phone Binary,
       avatar Binary,
       names SEQUENCE OF name Binary,
       surnames SEQUENCE OF name Binary,
       alias Binary,
       update INTEGER,
       settings SEQUENCE OF feature Feature,
       presence Presence,
       status MemberStatus, ... }

    MemberOp ::= ENUMERATED {
       get    (1),
       list   (2),
       add    (3),
       remove (4),
       update (5)
    }

    -- get/remove/update очікують actor + feed
    -- add використовує actor + feed
    -- list допускає фільтр за feed

    MemberQuery ::= SEQUENCE {
       op    MemberOp,

       actor [0] Binary OPTIONAL,
       feed  [1] MessageFeed OPTIONAL
    }

    MemberItem ::= SEQUENCE {
       actor   Binary,
       feed    MessageFeed,
       status  MemberStatus,
       presence Presence OPTIONAL
    }

    -- get/add/update зазвичай повертають item
    -- list повертає items

    MemberAnswer ::= SEQUENCE {
       item      [0] MemberItem OPTIONAL,
       items     [1] SEQUENCE OF item MemberItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL
    }

    ConferenceType ::= ENUMERATED { group (1), channel (2), call (3) }

    -- ConferenceStatus описує лише стан конференції як ресурсу.
    -- Command, lifecycle і події більше не живуть у Conference:
    --   create/add/remove/patch/get/delete -> Query
    --   join/leave/joined/removed          -> Event
    --   mute/unmute                        -> Query / Event
    --   lastmsg                            -> Query (Inbox/Search) або Event

    -- XMPP відповідність:
    --
    --   conference / group / channel:
    --     → XEP-0045 (Multi-User Chat)
    --
    -- Зауваження:
    --
    --   У XMPP багато логіки зашито в stanza.
    --   Тут модель розділена:
    --     - Conference = state
    --     - Event = runtime події
    --     - Query = команди
    --

    ConferenceStatus ::= ENUMERATED {
       active   (1),
       archived (2),
       deleted  (3), ...
    }

    -- lastmsg не є частиною Conference state.
    -- View-дані повинні передаватися через Query (Inbox/Search) або Event.
    --
    -- TODO: Unread Semantics
    --
    --   * unread може бути або:
    --       - похідним значенням (derived) від seq і read cursor
    --       - або кешованим view-полем (server-side aggregation)
    --
    --   * У поточній моделі unread визначається як:
    --       unread = current_seq(feed) - read_cursor(session)
    --
    --   * Поле unread у Conference НЕ є джерелом істини,
    --     а може використовуватись як оптимізація / snapshot.
    --
    --   * Поведінка синхронізації unread між session не визначена.

    Conference ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       name Binary,
       links SEQUENCE OF link Binary,
       description Binary,
       settings SEQUENCE OF feature Feature,
       members SEQUENCE OF member Member,
       admins SEQUENCE OF member Member,
       data SEQUENCE OF fileId Binary OPTIONAL,
       type ConferenceType,
       tos Binary,
       unread INTEGER,
       mentions SEQUENCE OF contact INTEGER,
       update INTEGER,
       created INTEGER,
       status ConferenceStatus,
        ... }

    ConferenceOp ::= ENUMERATED {
       get     (1),
       list    (2),
       create  (3),
       update  (4),
       remove  (5), ...
    }

    -- get/remove очікують id
    -- create/update використовують поля конференції
    -- list допускає частковий фільтр

    ConferenceQuery ::= SEQUENCE {
       op    ConferenceOp,
       id    [0] Binary OPTIONAL,
       name  [1] Binary OPTIONAL,
       type  [2] ConferenceType OPTIONAL,
       ...
    }

    -- get/create/update зазвичай повертають item
    -- list повертає items

    ConferenceAnswer ::= SEQUENCE {
       item      [0] ConferenceItem OPTIONAL,
       items     [1] SEQUENCE OF item ConferenceItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL,
       ...
    }

    ConferenceItem ::= SEQUENCE {
       id    Binary,
       name  Binary,
       type  ConferenceType,
       status ConferenceStatus
    }

    ConferenceExtension ::= CHOICE {
       request [1] ConferenceQuery,
       result  [2] ConferenceAnswer
    }

    -- 09 CHAT-v2 Protocol Entities

    CHATProtocol ::= CHOICE {
       authority [1] Authority,
       message   [2] Message,
       event     [4] Event,
       query     [5] Query
    }

    -- Transport Batching / Framing
    --
    --   * Транспортний контейнер може нести:
    --       - один пакет протоколу
    --       - або batch з кількох пакетів
    --
    --   * Batching використовується для:
    --       - зменшення transport overhead
    --       - групування дрібних Event/Query/Message
    --
    --   * Порядок елементів у batch зберігається.
    --
    --   * Batch є transport-оптимізацією і не змінює семантику
    --     окремих Message/Event/Query.
    CHATBody ::= CHOICE {
       single [1] CHATProtocol,
       batch  [2] SEQUENCE OF packet CHATProtocol
    }

    -- Security / Trust Boundaries
    --
    --   * TLS захищає transport channel між сусідніми вузлами,
    --     але не гарантує end-to-end недоторканність payload.
    --
    -- Trust Model:
    --
    --   * Клієнт довіряє authoritative broker/server тільки в межах:
    --       - routing
    --       - auth/session validation
    --       - replay / retention policy
    --
    --   * Проміжні broker в federation вважаються transport-trusted,
    --     але не payload-trusted.
    --
    -- Mutable by broker:
    --
    --   * headers
    --   * routing metadata
    --   * tracing metadata
    --
    -- Not mutable by broker:
    --
    --   * Message.payload
    --   * Event.payload
    --   * Query.payload
    --
    --   * Проміжні broker не повинні змінювати domain payload,
    --     навіть якщо вони форвардять пакет.
    --
    -- Token Handling:
    --
    --   * accessToken є transport credential і може перевірятись
    --     broker/server вузлом, який термінує transport session.
    --
    --   * refreshToken не повинен передаватись поза auth flow
    --     (Authority.authenticate / Authority.renew).
    --
    -- End-to-End Security:
    --
    --   * Якщо потрібна end-to-end цілісність або конфіденційність,
    --     вона повинна забезпечуватись на рівні payload
    --     (поза межами базового transport протоколу).
    --
    -- Transport headers
    --
    --   * headers можуть містити:
    --       - accessToken
    --       - routing metadata
    --       - tracing / delivery metadata
    --
    --   * accessToken використовується для авторизації конкретної session
    --     на transport рівні.
    Header ::= CHOICE {
       auth      [1] AuthHeader,
       routing   [2] RoutingHeader,
       tracing   [3] TracingHeader,
       ...
    }

    AuthHeader ::= SEQUENCE {
       accessToken Binary
    }

    -- Routing / Federation Semantics
    --
    --   * RoutingHeader використовується для transport-level маршрутизації
    --     між broker/server вузлами.
    --
    --   * target є optional routing hint для адресації кінцевого ресурсу
    --     або вузла призначення.
    --
    --   * feed задає логічний контекст маршрутизації повідомлення.
    --
    -- Authority:
    --
    --   * Для кожного feed існує authoritative broker/server,
    --     який відповідає за:
    --       - порядок подій у feed
    --       - seq у межах feed
    --       - retention / replay policy
    --
    -- Federation:
    --
    --   * Проміжні broker MAY форвардити пакети до authoritative вузла
    --     або до наступного маршруту.
    --
    --   * Проміжні broker не повинні змінювати семантику payload.
    --
    --   * Проміжні broker MAY додавати transport metadata у headers,
    --     але не повинні змінювати Message/Event/Query payload.
    --
    -- Ordering:
    --
    --   * Порядок подій гарантується тільки authoritative вузлом feed.
    --
    --   * Federation не гарантує глобальний порядок між різними feed
    --     або різними маршрутами.
    --
    -- Error Handling:
    --
    --   * Якщо маршрут невідомий або недоступний,
    --     сервер SHOULD повертати Query(type=error, code=notFound)
    --     або Query(type=error, code=unavailable).

    RoutingHeader ::= SEQUENCE {
       target [0] Binary OPTIONAL,
       feed   [1] MessageFeed OPTIONAL,
       broker [2] Binary OPTIONAL,
       ...
    }

    TracingHeader ::= SEQUENCE {
       traceId [0] Binary OPTIONAL,
       spanId  [1] Binary OPTIONAL,
       ...
    }

    CHATMessage ::= SEQUENCE {
       no INTEGER,
       headers SEQUENCE OF header Header,
       body CHATBody }

END