--- Протокол Месенжера Сохацького (Будда Протокол) v2 для паб-саб брокерів на TLS
--- https://tonpa.guru/stream/2023/2023-08-07%20CHAT%20ASN.1.htm
--- Верифікація протоколу для узгодженого порівняння з XMPP виконана Юрієм Масловським,
--- автором його першої імплементації для NYNJA.

CHAT-L2 DEFINITIONS IMPLICIT TAGS ::=
BEGIN
    -- CHAT-v2 design direction
    --
    -- Архітектурна мета:
    --   1. CHATProtocol містить тільки transport-level packet types.
    --   2. Message описує тільки контент повідомлення.
    --   3. Event є єдиним каналом runtime-подій (ack/activity/state updates).
    --   4. Query є єдиним request/response механізмом.
    --   5. Domain сутності (Subscription, Person, Member, Conference, Roster, Inbox view)
    --      не повинні бути top-level packet types.
    --
    -- Тобто одна семантика не повинна мати кілька паралельних wire-шляхів.

    -- IMPORTS ContentInfo FROM CryptographicMessageSyntax-2009
            -- CertificationRequest FROM PKCS-10
            -- Certificate FROM PKIX1Explicit-2009 ;

    -- NOTE:
    --   PKIX / PKCS ASN.1 модулі (Certificate, CertificationRequest)
    --   навмисно не імпортуються.
    --
    --   Причина:
    --     протокол не виконує parsing або валідацію сертифікатів,
    --     а лише транспортує їх як opaque binary payload.
    --
    --   Повний PKIX стек має глибокі залежності
    --   (PKIX-CommonTypes, AlgorithmInformation і т.д.),
    --   які не резолвляться erlc без повного набору модулів.
    --
    --   Тому сертифікати і CSR представлені як OCTET STRING,
    --   а їх інтерпретація є поза межами цього протоколу
    --   (crypto / application layer).

    CertificationRequest ::= OCTET STRING
    Certificate ::= OCTET STRING -- DER encoded X.509

    Version ::= INTEGER  { v0(0), v1(1), v2(2), v3(3) }

    -- Version Semantics
    --
    --   * vsn визначає wire-версію конкретного повідомлення.
    --
    --   * Клієнт і сервер MAY підтримувати кілька версій протоколу.
    --
    -- Compatibility:
    --
    --   * Якщо отримана версія підтримується, повідомлення
    --     обробляється за правилами цієї версії.
    --
    --   * Якщо версія не підтримується, сервер SHOULD повертати:
    --
    --       Query(type=error, code=unsupported)
    --
    -- Forward compatibility:
    --
    --   * Невідомі extension-поля SHOULD ігноруватись.
    --
    --   * Розширення через "..." не повинні ламати сумісність
    --     зі старішими реалізаціями.

    Flavour ::= ENUMERATED { apple (1), microsoft (2), google (3), ericsson (4), nokia (5), cisco (6) }
    Binary  ::= OCTET STRING
    Continuation ::= OCTET STRING

    -- NOTE:
    --   ContentInfo (CMS / PKCS#7) не використовується як структурований тип.
    --
    --   Протокол не виконує parsing або валідацію CMS payload,
    --   а лише транспортує дані як opaque binary.
    --
    --   Тому ContentInfo представлено як OCTET STRING.
    ContentInfo ::= OCTET STRING

    -- Session Semantics
    --
    -- Протокол розрізняє три рівні:
    --
    --   Identity: користувач
    --   Device: пристрій (телефон, браузер, десктоп)
    --   Session: runtime-екземпляр клієнта (запуск застосунку або вкладка)
    --
    -- Session представляє конкретний клієнтський інстанс.
    --
    -- Властивості:
    --
    --   * Один користувач MAY мати кілька device.
    --   * Один device MAY мати кілька session.
    --   * Session є незалежними одна від одної.
    --
    -- Важливо:
    --
    --   * Session НЕ є транспортним з'єднанням.
    --   * Session НЕ є користувачем.
    --   * Session переживає reconnect.
    --
    -- Життєвий цикл:
    --
    --   * Session створюється під час authenticate.
    --   * Session ідентифікується через session_id.
    --   * Session MAY бути відновлена після reconnect.
    --
    -- Використання:
    --
    --   * Поле session у Message/Event/Query/Authority означає
    --     контекст конкретного клієнтського інстансу.
    --
    -- Session Lifecycle Policy
    --
    --   * Session створюється тільки через Authority.authenticate.
    --
    --   * Session має життєвий цикл:
    --       - active
    --       - expired
    --       - revoked
    --
    --   * reconnect не створює нову session,
    --     а відновлює існуючу session за умови, що:
    --       - session існує
    --       - accessToken валідний
    --       - session не expired і не revoked
    --
    --   * renew не створює session,
    --     а лише перевидає accessToken через refreshToken.
    --
    --   * authenticate з refreshToken MAY:
    --       - відновити існуючу session
    --       - або створити нову session,
    --         якщо попередня session втрачена або expired
    --
    --   * revoke accessToken інвалідує конкретну session.
    --
    --   * revoke refreshToken MAY інвалідувати всі session,
    --     пов'язані з device/client.
    --
    --   * Session MAY мати server-side TTL і завершуватись
    --     після періоду неактивності.

    -- 01 Authority (CA)

    Feature ::= SEQUENCE { id Binary, key Binary, value Binary, group Binary }
    -- Feature / Capability Negotiation
    --
    --   * Feature використовується для опису можливостей клієнта і сервера.
    --
    --   * Feature.id визначає тип capability.
    --
    --   * key/value можуть використовуватись для параметризації feature.
    --
    -- Usage:
    --
    --   * Сервер MAY передавати список підтримуваних feature
    --     через Authority.settings (announce / authenticate).
    --
    --   * Клієнт MAY передавати підтримувані feature
    --     через AuthRequest (через settings або окреме поле).
    --
    -- Negotiation:
    --
    --   * Клієнт і сервер повинні використовувати тільки
    --     перетин підтримуваних feature.
    --
    --   * Невідомі feature повинні ігноруватись.
    --
    -- Приклади:
    --
    --   * typingOptimized
    --   * readCursor
    --   * batchTransport
    --   * federationRouting

    AuthorityMethod ::= ENUMERATED { announce (0), enroll (1), authenticate (2), revoke (3), renew (4), ... }
    -- Authority Method Semantics
    --
    -- announce:
    --   * server capabilities / bootstrap metadata
    --
    -- enroll:
    --   * первинна реєстрація device/client або сертифіката
    --
    -- authenticate:
    --   * створює нову session
    --   * або відновлює існуючу session через session + accessToken
    --
    -- renew:
    --   * перевидає accessToken через refreshToken
    --   * може також повертати новий refreshToken
    --
    -- revoke:
    --   * інвалідує accessToken конкретної session
    --   * або всі session, пов'язані з device/client

    -- AuthRequest використовується для:
    --   - первинної аутентифікації
    --   - reconnect існуючої session
    --   - renew access token через refresh token
    -- Token Scope
    --
    --   * accessToken прив'язаний до конкретної session
    --     і використовується для transport authorization / reconnect.
    --
    --   * refreshToken прив'язаний до device/client
    --     і використовується для перевидачі accessToken.
    --
    --   * Один device MAY мати кілька session.
    --
    --   * Відкликання accessToken повинно впливати тільки
    --     на відповідну session.
    --
    --   * Відкликання refreshToken може інвалідовувати
    --     всі session, пов'язані з device/client.
    --
    -- Version Negotiation
    --
    --   * Під час authenticate клієнт MAY передати supportedVsn:
    --     перелік підтримуваних wire-версій.
    --
    --   * Сервер MAY вибрати сумісну версію і повернути її
    --     в AuthAnswer.selectedVsn.
    --
    --   * Якщо спільної версії немає, сервер SHOULD повертати:
    --
    --       Query(type=error, code=unsupported)
    AuthRequest ::= SEQUENCE {
       accessToken  [0] Binary OPTIONAL,
       refreshToken [1] Binary OPTIONAL,
       device       [2] Binary OPTIONAL,
       client       [3] Binary OPTIONAL,
       phone        [4] Binary OPTIONAL,
       sms          [5] Binary OPTIONAL,
       os           [6] INTEGER OPTIONAL,
       services     [7] INTEGER OPTIONAL,
       push         [8] Binary OPTIONAL,
       supportedVsn [9] SEQUENCE OF version Version OPTIONAL,
       ...
    }

    -- AuthAnswer повертає токени та параметри session
    -- після authenticate / renew.
    -- accessToken авторизує конкретну session.
    -- refreshToken дозволяє перевидачу accessToken для device/client.
    AuthAnswer ::= SEQUENCE {
       accessToken  [0] Binary OPTIONAL,
       refreshToken [1] Binary OPTIONAL,
       device       [2] Binary OPTIONAL,
       client       [3] Binary OPTIONAL,
       services     [4] INTEGER OPTIONAL,
       selectedVsn  [5] Version OPTIONAL,
       ...
    }

    -- Authority / Certificate Trust Model
    --
    --   * Authority є trust endpoint для:
    --       - enroll
    --       - authenticate
    --       - renew
    --       - revoke
    --
    --   * Authority MAY виступати як:
    --       - certification authority
    --       - registration authority
    --       - auth/session authority
    --
    -- Trust Root:
    --
    --   * Клієнт повинен мати довіру до Authority поза межами
    --     самого transport протоколу.
    --
    --   * TLS захищає transport channel, але не замінює
    --     довіру до Authority як issuer / validator.
    --
    -- Certificates:
    --
    --   * cert використовується для:
    --       - certificate request під час enroll
    --       - certificate delivery / renewal
    --       - certificate validation context
    --
    --   * Точний формат cert визначається контекстом AuthorityMethod.
    --
    -- Enroll:
    --
    --   * enroll MAY приймати CertificationRequest
    --     і повертати Certificate.
    --
    -- Authenticate:
    --
    --   * authenticate MAY використовувати:
    --       - token-based auth
    --       - certificate-based auth
    --       - або комбінований режим
    --
    -- Revoke:
    --
    --   * revoke MAY інвалідовувати:
    --       - session / token
    --       - certificate
    --       - або device/client binding

    AuthorityCert ::= CHOICE {
       request     [1] CertificationRequest,
       certificate [2] Certificate,
       chain       [3] SEQUENCE OF certificate Certificate,
       ...
    }

    -- Session / Read Note
    --
    --   * last_seq лишається session-scoped replay position.
    --
    --   * read cursor не належить session:
    --     canonical semantics і source of truth визначаються в CursorCore.
    --
    Authority ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       type AuthorityMethod,
       request [0] AuthRequest OPTIONAL,
       result  [1] AuthAnswer OPTIONAL,

       -- cert містить certificate-related payload:
       --   - request     (CertificationRequest) для enroll
       --   - certificate (Certificate) для delivery / renew
       --   - chain       (Certificate chain) для trust bootstrap
       --   - CertificationRequest для enroll
       --   - Certificate для renew / delivery
       --   - validation context для authenticate
       cert [2] AuthorityCert OPTIONAL,
       settings SEQUENCE OF feature Feature OPTIONAL,
        ... }

    -- 02 Message (MNESIA, SQLite)

    -- Message описує тільки саме повідомлення і його вміст.
    -- Event є уніфікованим типом для всіх подій (Ack + Activity).
    -- Такий поділ мінімізує розмір базових повідомлень і не змішує семантику.
    --
    -- Message Payload Semantics
    --
    --   * payload може бути структурованим.
    --
    --   * body не є єдиним полем payload.
    --
    --   * повідомлення може містити document-like дані
    --     з семантикою field / value.
    --
    --   * така модель використовується для сценаріїв
    --     з документами і ABAC policy evaluation.

    MessageType ::= ENUMERATED { normal (0), sys (1), reply (2), forward (3), ... }

    MessageFeed ::= CHOICE { private [1] Privatebox, chan [2] Streambox, mailbox [4] Mailbox, group [8] Groupbox, ... }

    -- Group Feed Semantics
    --
    --   * MessageFeed.group посилається на існуючий Conference ресурс
    --     типу group.
    --
    --   * group feed не є окремою автономною сутністю поза Conference.
    --
    --   * Доступ до group feed визначається membership state:
    --       - member / owner MAY читати і писати в group feed
    --       - non-member не повинен мати доступу до group feed
    --
    --   * Для non-member доступ до:
    --       - Message send
    --       - InboxQuery
    --       - Event replay
    --     повинен завершуватись Query(type=error, code=forbidden).
    --
    --   * Якщо відповідний Conference видалений або не існує,
    --     group feed повинен вважатись недоступним:
    --
    --       Query(type=error, code=notFound)

    File ::= SEQUENCE {
       id Binary,
       mime Binary,
       payload ContentInfo,
       parentid Binary }

    -- Message Identity and Payload Semantics
    --
    --   * Message описує тільки intent/content повідомлення.
    --
    --   * Message.id є єдиною protocol-level identity
    --     повідомлення.
    --
    --   * Message.id є глобально унікальним і стабільним
    --     протягом усього lifecycle повідомлення.
    --
    --   * payload є частиною message state,
    --     а body є лише одним із можливих полів payload.
    --
    --   * runtime mutation semantics визначаються через MessageEvent.
    --
    Message ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       feed MessageFeed,
       payload ContentInfo,
       type MessageType OPTIONAL,
       link Binary OPTIONAL,
       files [0] SEQUENCE OF file File OPTIONAL,
       mentioned [1] SEQUENCE OF name Binary OPTIONAL,
       ...
    }

    -- 03 Inbox Folder Queue (MNESIA, SQLite) /Mail /Chat
    -- XMPP відповідність:
    --
    --   inbox / message retrieval:
    --     → XEP-0313 (Message Archive Management)
    --
    -- Зауваження:
    --
    --   У XMPP це окремий extension.
    --   Тут це частина core Query моделі.
    --

    Privatebox ::= SEQUENCE { address Binary }
    Streambox ::= SEQUENCE { channel Binary }
    Groupbox ::= SEQUENCE { channel Binary }
    Mailbox ::= SEQUENCE { channel Binary }

    InboxMethod ::= ENUMERATED { get (1), erase (2), ...}

    Inbox ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       type InboxMethod,
       feed MessageFeed,
       messages [0] SEQUENCE OF message Message OPTIONAL,
        ... }

    InboxOp ::= ENUMERATED {
       get   (1),
       erase (2),
       ...
    }

    -- get/erase працюють у межах конкретного feed
    -- для обох операцій feed очікується
    InboxQuery ::= SEQUENCE {
       op    InboxOp,
       feed  [0] MessageFeed OPTIONAL,
       ...
    }

    InboxItem ::= SEQUENCE {
       message Message
    }

    -- Inbox pagination semantics
    --
    --   * continue є opaque cursor для отримання наступної сторінки.
    --
    --   * hasMore є hint, що на момент формування відповіді можуть існувати
    --     додаткові елементи.
    --
    --   * hasMore НЕ гарантує повноту або стабільність snapshot:
    --       - дані можуть змінюватись між запитами
    --       - можливі дублікати або пропуски
    --
    --   * snapshotSeq є feed-scoped snapshot boundary
    --     для цього InboxAnswer.
    --
    --   * Якщо snapshot повертається у кількох сторінках,
    --     snapshotSeq визначається на першій сторінці і лишається
    --     спільним для всіх continue у межах цього snapshot.
    --
    --   * Recovery / replay semantics для after / nextAfter
    --     визначаються в EventCore.
    --
    -- Snapshot vs Read Cursor
    --
    --   * snapshotSeq не є read cursor.
    --
    --   * Inbox snapshot не повинен автоматично оновлювати read state.
    --
    --   * Canonical read semantics визначаються в CursorCore.
    --
    InboxAnswer ::= SEQUENCE {
       items       [0] SEQUENCE OF item InboxItem OPTIONAL,
       continue    [1] Continuation OPTIONAL,
       hasMore     [2] BOOLEAN OPTIONAL,
       snapshotSeq [3] INTEGER OPTIONAL,
       ...
    }

    -- 04 Event (Ack + Activity fusion)
    --
    -- Event є єдиним каналом runtime-подій.
    -- Події групуються за family payload, без глобального плаского enum.
    -- Для простих family тип події задається локальним enum усередині payload.

    -- XMPP відповідність:
    --
    --   delivered / received / read:
    --     → XEP-0184 (Message Delivery Receipts)
    --
    --   deleted (message retraction):
    --     → XEP-0425 (Message Retraction)
    --
    --   edited / updated:
    --     → XEP-0308 (Last Message Correction)
    --

    MessageEventType ::= ENUMERATED {
       received  (1),
       delivered (2),
       read      (3),
       edited    (4),
       deleted   (5),
       updated   (6), ...}

    -- Message Event Semantics
    --
    --   * MessageEvent є canonical runtime-моделлю для:
    --       - delivered / read / received
    --       - edited / deleted / updated
    --
    -- Delivery / read:
    --
    --   * delivered і read є різними подіями і не повинні
    --     зливатися в одну семантику.
    --
    --   * delivered означає доставку конкретній session,
    --     але не означає фактичне відображення або прочитання.
    --
    --   * client-originated read update передається через Query / CursorCore.
    --
    --   * MessageEvent(type=read) є server-emitted фактом
    --     уже застосованого read state.
    --
    --   * readSeq є джерелом істини для read cursor у feed:
    --
    --         effective_read_cursor(user, feed) = max(current, readSeq)
    --
    --   * messageId для read є тільки optional auxiliary reference.
    --
    --   * Детальна semantics read cursor, replay і projection-виглядів
    --     визначається в CursorCore та FeedViewItem.readSeq.
    --
    -- Mutation:
    --
    --   * MessageEvent(type=edited|deleted|updated) адресує
    --     існуючий message state через messageId.
    --
    --   * Такі event-и не створюють новий Message,
    --     а змінюють current state уже існуючого Message.id.
    --
    --   * messageId є stable reference для mutation target.
    --
    --   * delete має пріоритет над edited/updated.
    --
    --   * replay і звичайна online-обробка повинні
    --     конвергувати до однакового final state.
    --
    MessageEvent ::= SEQUENCE {
       type       MessageEventType,
       messageId  [0] Binary OPTIONAL,
       -- messageId:
       --
       --   * stable reference до Message.id,
       --     над яким виконується lifecycle/mutation event.
       --
       --   * для read може бути optional auxiliary reference,
       --     але для edited/deleted/updated саме messageId
       --     визначає target message state.

       feed       [1] MessageFeed OPTIONAL,
       actor      [2] Binary OPTIONAL,
       timestamp  [3] INTEGER OPTIONAL,
       readSeq    [4] INTEGER OPTIONAL,
       ...
    }

    -- XMPP відповідність:
    --
    --   online / offline:
    --     → RFC 3921 (Presence)
    --
    --   typing:
    --     → XEP-0085 (Chat State Notifications)
    --

    PresenceEventType ::= ENUMERATED {
       online   (1),
       offline  (2),
       typing   (3), ...}

    PresenceEvent ::= SEQUENCE {
       type       PresenceEventType,
       feed       [0] MessageFeed OPTIONAL,
       actor      [1] Binary OPTIONAL,
       timestamp  [2] INTEGER OPTIONAL,
       ...
    }

    EventPayload ::= CHOICE {
       message   [1] MessageEvent,
       presence  [2] PresenceEvent
    }

    -- Event Sequencing and Consistency
    --
    --   * Event є єдиним transport-level каналом runtime-подій.
    --
    --   * seq є feed-scoped порядковою позицією
    --     і монотонно зростає в межах feed.
    --
    --   * seq не є глобальним і використовується для replay,
    --     recovery та виявлення пропусків.
    --
    --   * last_seq є session-local replay cursor.
    --
    --   * Події можуть приходити поза порядком, дублюватись
    --     або приходити із затримкою.
    --
    --   * Протокол не гарантує causal ordering між подіями.
    --
    --   * Для state-changing events застосовується
    --     базова conflict resolution модель протоколу.
    --
    --   * Локальна semantics mutation/read визначається
    --     відповідними payload family (MessageEvent, CursorCore).
    --
    Event ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       seq INTEGER,
       payload EventPayload,
       ...
    }

    -- Query є єдиним request/response шаром протоколу.
    -- Усі commands і state-запити повинні йти через Query.
    -- Payload уже розбитий на доменні family envelope.
    -- Внутрішні request/result payload типи тимчасово залишаються opaque
    -- до поступової типізації кожної family окремо.
    --
    -- Query / Command Evaluation Semantics
    --
    --   * Кожна command/query оцінюється за поточним server state
    --     на момент її обробки.
    --
    --   * Authorization, moderation policy, membership і existence resource
    --     не фіксуються наперед transport-пакетом або snapshot boundary,
    --     а перевіряються під час фактичного виконання.
    --
    --   * already accepted command не повинна відкочуватись ретроактивно
    --     через пізнішу зміну policy/resource state
    --     (наприклад ban, remove member, delete conference).
    --
    --   * Нова command після зміни policy/resource state
    --     повинна оцінюватись уже за новим state.
    --
    -- Reconnect Semantics
    --
    -- Транспортне зєднання може перериватись і відновлюватись.
    --
    -- Session:
    --
    --   - Session залишається валідною при reconnect.
    --   - Клієнт SHOULD повторно використовувати існуючу session.
    --
    -- Доставка подій:
    --
    --   - Після reconnect клієнт MAY отримати пропущені події.
    --   - Механізм відновлення (replay / fetch) реалізується через Query.
    --
    -- Важливо:
    --
    --   - Протокол не гарантує доставку всіх подій без повторного запиту.
    --   - Клієнт повинен бути готовий до втрати частини історії подій.
    --
    -- Recovery:
    --
    --   - Клієнт повинен зберігати останній отриманий seq.
    --
    --   - Після reconnect клієнт виконує Query для отримання подій
    --     починаючи з відомого seq.
    --
    --   - Сервер повертає події з seq > last_seq.
    --
    --   - Пропущені події відновлюються через цей механізм.
    --
    -- Offline:
    --
    --   - Офлайн режим не є окремою концепцією протоколу.
    --
    --   - Пропущені події відновлюються через seq (Event replay).
    --
    --   - У випадку втрати історії (gap) використовується Query (Inbox).
    --
    -- Retention and Gap Handling
    --
    --   * Сервер може обмежувати збереження подій у feed (retention).
    --
    --   * Якщо клієнт запитує after, який менший за мінімальний
    --     доступний seq, виникає gap (втрата частини історії).
    --
    -- Gap Detection:
    --
    --   * У випадку gap сервер SHOULD повертати:
    --
    --       Query(type=error, code=gap)
    --
    --   * Це означає, що частина історії подій недоступна.
    --
    -- Client Behavior:
    --
    --   * Клієнт повинен виконати повний sync через:
    --       - Inbox Query
    --       - або інші view-запити
    --
    --   * Якщо InboxAnswer містить snapshotSeq,
    --     клієнт MAY продовжити recovery через Event replay
    --     з after = snapshotSeq.
    --
    --   * Клієнт НЕ повинен припускати повноту даних,
    --     якщо seq має розрив.
    --
    -- Важливо:
    --
    --   * Event replay гарантує тільки partial recovery.
    --
    --   * Повна консистентність відновлюється через snapshot (Inbox).
    --
    -- Delivery Guarantees
    --
    --   * Базова модель доставки для Message і Event є at-least-once.
    --
    --   * Протокол допускає повторну доставку пакетів після retry
    --     або reconnect.
    --
    --   * Message і Event повинні бути ідемпотентними:
    --       - Message: через унікальний Message.id
    --       - Event: через Event.id і/або seq у межах feed
    --
    --   * received / delivered / read є application-level подіями
    --     і не означають exact-once гарантії transport-рівня.
    --
    --   * Exactly-once не є ціллю базової моделі протоколу.
    --
    -- Preview Semantics
    --
    --   * клієнт може використовувати Event replay з limit
    --     для отримання лише останніх подій (preview mode).
    --
    --   * preview mode не означає повного відновлення історії.
    --
    --   * preview mode не повинен автоматично оновлювати read cursor.
    --
    --   * read cursor оновлюється тільки через явний CursorCore update.

    -- XMPP відповідність:
    --
    --   Query (request/response):
    --     → XEP-0004 (Data Forms)
    --     → XEP-0030 (Service Discovery)
    --
    -- Зауваження:
    --
    --   У XMPP request/response розподілений по різних stanza.
    --   У даному протоколі він уніфікований через Query.
    --


    QueryType ::= ENUMERATED {
       get    (1),
       set    (2),
       result (3),
       error  (4), ...}

    QueryError ::= ENUMERATED {
       badRequest          (1),
       unauthorized        (2),
       forbidden           (3),
       notFound            (4),
       conflict            (5),
       unsupported  (6),
       gap         (7),
       rateLimited         (8),
       internalError       (9),
       unavailable         (10),
       ...
    }

    -- Query Error Semantics
    --
    --   * Query(type=error) використовується для повернення
    --     типізованої помилки request/response рівня.
    --
    --   * code визначає категорію помилки.
    --
    -- Retryable:
    --
    --   * unavailable
    --   * rateLimited
    --
    -- Recoverable with client action:
    --
    --   * unauthorized       -> renew / authenticate
    --   * unsupported -> fallback version
    --   * gap        -> full sync через Inbox / view Query
    --
    -- Fatal for request:
    --
    --   * badRequest
    --   * forbidden
    --   * notFound
    --   * conflict
    --
    -- Group / Moderation-specific usage:
    --
    --   * forbidden:
    --       - non-member access до group feed / group membership protected operation
    --       - actor або target заблокований moderation policy для цієї операції
    --
    --   * notFound:
    --       group/conference resource не існує або вже видалений
    --
    Query ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       queryType QueryType,
       ref [0] Binary OPTIONAL, -- request correlation id
       feed [1] MessageFeed OPTIONAL,
       target [2] Binary OPTIONAL, -- optional routing hint; domain target belongs in payload
       payload [3] QueryPayload OPTIONAL, -- typed query family payload
       code [4] QueryError OPTIONAL,
       limit    [5] INTEGER OPTIONAL,
       continue [6] Continuation OPTIONAL,
       ...
    }

    QueryPayload ::= CHOICE {
       subscription [1] SubscriptionCore,
       presence     [2] PresenceCore,
       person       [3] PersonCore,
       roster       [4] RosterCore,
       member       [5] MemberExtension,
       conference   [6] ConferenceExtension,
       moderation   [7] ModerationExtension,
       inbox        [8] InboxExtension,
       search       [9] SearchExtension,
       bpe          [10] ProcessExtension,
       kvs          [11] StorageExtension,
       mail         [12] MailExtension, -- X.420
       event        [13] EventCore,
       cursor       [14] CursorCore,
       home         [15] HomeCore,
       ...
    }

    ProcessExtension ::= CHOICE { request [1] Binary, result [2] Binary }
    StorageExtension ::= CHOICE { request [1] Binary, result [2] Binary }
    MailExtension    ::= CHOICE { request [1] Binary, result [2] Binary }

    SubscriptionCore ::= CHOICE {
       request [1] SubscriptionQuery,
       result  [2] SubscriptionAnswer
    }

    PresenceCore ::= CHOICE {
       request [1] PresenceQuery,
       result  [2] PresenceAnswer
    }

    PersonCore ::= CHOICE {
       request [1] PersonQuery,
       result  [2] PersonAnswer
    }

    MemberExtension ::= CHOICE {
       request [1] MemberQuery,
       result  [2] MemberAnswer
    }

    InboxExtension ::= CHOICE {
       request [1] InboxQuery,
       result  [2] InboxAnswer
    }

    -- Cursor Core (user/feed position state)
    --
    --   * CursorCore є canonical protocol-level моделлю для cursor state у feed.
    --
    --   * У базовій моделі підтримується тільки cursor kind = read.
    --
    --   * Cursor update є client-originated command через Query,
    --     а server застосовує його до effective cursor state.
    --
    --   * Для read використовується монотонне правило:
    --
    --       effective_cursor(user, feed, read) = max(current, seq)
    --
    --   * update з меншим seq не повинен зменшувати поточний cursor.
    --
    --   * Після успішного застосування server MAY згенерувати
    --     MessageEvent(type=read) як факт уже застосованого стану.
    --
    -- Source of truth:
    --
    --   * CursorCore є єдиним джерелом істини для read cursor state.
    --
    --   * FeedViewItem.readSeq і MessageEvent.readSeq є похідними представленнями.
    --
    --   * Event і View не повинні використовуватись для оновлення cursor.
    --
    -- Scope / limits:
    --
    --   * CursorCore не є replay API; replay event stream лишається в EventCore.
    --
    --   * cursor rewind / mark unread не входить до базової моделі.
    --
    --   TODO:
    --     визначити semantics для unread / cursor rewind:
    --       - чи дозволяється backward move effective cursor
    --       - як взаємодіє з read (монотонність vs rewind)
    --       - чи генерується окремий Event
    --
    CursorKind ::= ENUMERATED {
       read (1),
       ...
    }

    CursorOp ::= ENUMERATED {
       get    (1),
       update (2),
       ...
    }

    CursorQuery ::= SEQUENCE {
       op    CursorOp,
       kind  [0] CursorKind OPTIONAL,
       feed  [1] MessageFeed OPTIONAL,
       seq   [2] INTEGER OPTIONAL,
       ...
    }

    CursorAnswer ::= SEQUENCE {
       kind  [0] CursorKind OPTIONAL,
       feed  [1] MessageFeed OPTIONAL,
       seq   [2] INTEGER OPTIONAL,
       ...
    }

    CursorCore ::= CHOICE {
       request [1] CursorQuery,
       result  [2] CursorAnswer
    }

    -- Home Core (bootstrap / home view)
    --
    -- HomeCore використовується для отримання агрегованого snapshot/view
    -- після connect/reconnect або для побудови home screen.
    --
    -- Семантика:
    --
    --   * Home є multi-feed view:
    --       - список feed (діалоги / конференції)
    --       - preview (останні повідомлення)
    --       - unread/read-derived стан
    --       - mention-derived стан
    --
    --   * HomeAnswer.items повертає FeedViewItem,
    --     а не canonical domain state ресурсу.
    --
    --   * Home НЕ є джерелом істини:
    --       - це snapshot/view, подібний до Inbox або Roster
    --
    --   * Home snapshot може використовуватись як anchor
    --     для подальшого Event replay у кількох feed.
    --
    --   * Home snapshot є shared:
    --       - один anchor для кількох feed
    --       - boundary визначається для кожного feed окремо
    --
    --   * Home pagination використовує continuation token,
    --     аналогічно іншим view query.
    --
    -- Важливо:
    --
    --   * Home НЕ замінює:
    --       - Inbox (per-feed snapshot)
    --       - Roster (relation view)
    --
    --   * Home є агрегованим bootstrap/view ресурсом.
    --
    -- Home Query Model
    --
    --   * Home є єдиним bootstrap/view query.
    --
    --   * Окремий op для Home не використовується:
    --       - сам факт QueryPayload.home означає home bootstrap request
    --
    --   * previewLimit обмежує кількість preview data на feed.
    --
    --   * includeRoster дозволяє клієнту явно запросити
    --     optional roster view у складі HomeAnswer.
    --
    -- Home vs Inbox
    --
    --   * Home використовується для:
    --       - reconnect bootstrap
    --       - home screen / dialog list
    --       - multi-feed preview
    --
    --   * Inbox використовується для:
    --       - точного per-feed snapshot
    --       - gap recovery
    --       - message retrieval у межах одного feed
    --
    --   * Home не замінює Inbox:
    --       - Home є агрегованим multi-feed view
    --       - Inbox є точним feed-scoped snapshot
    --
    --   * Для повного recovery окремого feed клієнт повинен
    --     використовувати InboxQuery або Event replay,
    --     залежно від recovery context.
    --
    -- includeRoster semantics
    --
    --   * Якщо includeRoster = true,
    --     сервер MAY включити roster view у HomeAnswer.
    --
    --   * Якщо includeRoster відсутній або false,
    --     сервер MAY опустити roster для зменшення обсягу bootstrap result.
    --
    --   * includeRoster не змінює relation state
    --     і не впливає на messaging semantics.
    --
    HomeQuery ::= SEQUENCE {
       previewLimit  [0] INTEGER OPTIONAL,
       includeRoster [1] BOOLEAN OPTIONAL,
       ...
    }

    -- Feed View Model
    --
    --   * FeedViewItem є агрегованим snapshot/view item
    --     для bootstrap/home/feed list.
    --
    --   * FeedViewItem є спільною projection-моделлю
    --     для private/group/channel/mailbox feed.
    --
    --   * FeedViewItem не є джерелом істини для:
    --       - Message state
    --       - Conference state
    --       - Subscription state
    --
    --   * unread / mentions / preview належать до view layer,
    --     а не до canonical domain state feed ресурсу.
    --
    -- Mention View Semantics
    --
    --   * MentionView є user-scoped derived view.
    --
    --   * count і latestSeq НЕ є canonical state,
    --     а обчислюються сервером на основі:
    --       - mention flags у Message
    --       - read cursor(user, feed)
    --
    --   * messageId є stable reference до останнього mention message,
    --     але не є частиною read або cursor state.
    --
    --   * MentionView не впливає на delivery, ordering або replay semantics.
    --
    MentionView ::= SEQUENCE {
       count      [0] INTEGER OPTIONAL,
       latestSeq  [1] INTEGER OPTIONAL,
       messageId  [2] Binary OPTIONAL,
       ...
    }

    FeedViewItem ::= SEQUENCE {
       feed      MessageFeed,
       message   [0] Message OPTIONAL,

        -- headSeq — останній відомий seq у feed на момент snapshot
       headSeq   [1] INTEGER OPTIONAL,

        -- readSeq — projection effective read cursor(user, feed)
        --   у view layer.
        --
        --   * Джерелом істини лишається CursorCore.
        --
        --   * FeedViewItem.readSeq є derived value і не використовується
        --     для оновлення read state.
       readSeq   [2] INTEGER OPTIONAL,

        -- unread є derived/cached значенням:
        --   unread = max(0, headSeq - readSeq)
        --
        -- unread не є джерелом істини
       unread    [3] INTEGER OPTIONAL,

        -- mentions є user-scoped snapshot/view state:
        --   count      = кількість unread mention для цього user у feed
        --   latestSeq  = jump anchor до останнього mention
        --   messageId  = stable reference до останнього mention message
       mentions   [4] MentionView OPTIONAL,
       ...
    }

    -- Home pagination і snapshot semantics
    --
    --   * continue є opaque cursor для pagination home view.
    --
    --   * hasMore є hint про наявність додаткових feed.
    --
    --   * snapshot є shared opaque anchor для цього HomeAnswer.
    --
    --   * snapshot може використовуватись як bootstrap boundary
    --     для replay тільки у feed, покритих цим HomeAnswer.
    --
    --   * replay semantics для boundary / no-duplicates / no-gaps
    --     визначаються в EventCore.
    --
    -- Consistency:
    --
    --   * Home не гарантує snapshot isolation.
    --
    --   * Home snapshot не заморожує authorization, moderation,
    --     membership або existence resource.
    --
    HomeAnswer ::= SEQUENCE {
       items     [0] SEQUENCE OF item FeedViewItem OPTIONAL,
       continue  [1] Continuation OPTIONAL,
       hasMore   [2] BOOLEAN OPTIONAL,

       -- shared home snapshot anchor
       snapshot  [3] Binary OPTIONAL,

        -- optional roster snapshot (view)
        --
        --   * roster використовується як допоміжний view для home screen
        --     (наприклад contact list / metadata для feed)
        --
        --   * roster НЕ є джерелом істини для relation
        --     і не впливає на messaging semantics
        --
        --   * сервер MAY повертати:
        --       - повний roster snapshot
        --       - або скорочений (condensed) subset
        --
        --   * клієнт не повинен припускати повноту roster у HomeAnswer
        --
        --   * для повного roster клієнт повинен використовувати RosterQuery
       roster    [4] RosterAnswer OPTIONAL,
       ...
    }

    HomeCore ::= CHOICE {
       request [1] HomeQuery,
       result  [2] HomeAnswer
    }

    -- Pagination / Streaming (view queries)
    --
    --   * Для snapshot/view даних (roster, members, search, conference)
    --     використовується continuation-based pagination.
    --
    --   * limit задає максимальний розмір сторінки.
    --
    --   * continue є opaque token, який визначає позицію
    --     у результаті запиту.
    --
    --   * Сервер MAY повертати:
    --       - continue: token для наступної сторінки
    --       - hasMore: ознаку наявності додаткових даних
    --
    --   * Клієнт не повинен інтерпретувати continuation token.
    --
    --   * Pagination не гарантує snapshot isolation:
    --       - дані можуть змінюватись між сторінками
    --       - можливі дублікати або пропуски
    --
    --   * Для повної консистентності клієнт може виконати
    --     повторний повний запит.

    -- Event Core (recovery / replay)
    --
    --   * EventCore є canonical API для replay / recovery event stream.
    --
    --   * Підтримуються три режими використання:
    --       - recovery mode
    --       - preview mode
    --       - streaming mode
    --
    --   * Client-originated cursor/state updates не входять до EventCore
    --     і передаються через CursorCore.
    --
    --   * Події є спільним stream у межах feed.
    --
    --   * seq є feed-scoped і монотонно зростаючим.
    --
    --   * Recovery виконується від імені конкретної session
    --     через її local replay position (last_seq).


    EventQuery ::= SEQUENCE {
       after [0] INTEGER OPTIONAL,
       limit [1] INTEGER OPTIONAL,
       ...
    }

    -- Event Pagination / Streaming
    --
    --   * after задає нижню межу replay:
    --       сервер повертає події з seq > after.
    --
    --   * limit задає максимальну кількість подій у відповіді.
    --
    --   * Якщо відповідь обрізана, сервер MAY повернути:
    --       - nextAfter: останній seq у поточній сторінці
    --       - hasMore: ознаку наявності наступної сторінки
    --
    --   * Продовження replay через after = nextAfter
    --     утворює lossless continuation boundary:
    --       - без повторного повернення вже покритих подій
    --       - без втрати подій з seq > nextAfter
    --
    EventAnswer ::= SEQUENCE {
       events     [0] SEQUENCE OF event Event OPTIONAL,
       nextAfter  [1] INTEGER OPTIONAL,
       hasMore    [2] BOOLEAN OPTIONAL,
       ...
    }

    EventCore ::= CHOICE {
       request [1] EventQuery,
       result  [2] EventAnswer
    }

    -- 05 Search (LDAP-backed query/view extension)
    --
    -- Search у протоколі використовує LDAP-oriented request shape,
    -- але на chat semantics рівні трактується як read-only query/view layer.
    --
    -- Тобто:
    --   * transport/wire form може лишатися LDAP-shaped
    --   * semantic model для клієнта є search over visible message/feed scope
    --
    SearchStatus ::= ENUMERATED { ok (0), ...}

    -- TODO:
    --   * вирішити, чи SearchStatus справді потрібен як окремий тип
    --     у протоколі
    --
    --   * якщо success/error повністю кодуються через:
    --       Query(type=result)
    --       Query(type=error, code=...)
    --     тоді SearchStatus можна прибрати як зайвий
    --
    --   * якщо потрібен окремий backend/service status,
    --     треба явно визначити, де саме він повертається
    --     (наприклад у SearchAnswer)

    Criteria ::= ENUMERATED { equal (0), notequal (1), like (2), ...}

    -- Scope визначає backend search domain / object family.
    --
    -- Для chat message search базовий executable subset використовує:
    --   * type = message
    --
    -- room/chat/profile/contact/member можуть використовуватись
    -- як future extension для richer directory / discovery search.
    --
    Scope ::= ENUMERATED { profile (0), folder (1), contact (2), member (3), room (4), chat (5), message (6), ...}

    SearchOp ::= ENUMERATED {
       execute (1),
       list    (2),
       ...
    }

    -- execute використовує field/value/criteria/type
    -- list допускає частковий фільтр або перегляд у межах scope/dn
    --
    -- Chat-facing canonical forms у DSL є sugar над SearchQuery.
    --
    -- Приклади semantic mapping:
    --
    --   query search text "draft"
    --     -> SearchQuery {
    --          op       = execute,
    --          field    = "body",
    --          value    = "draft",
    --          criteria = like,
    --          type     = message
    --        }
    --
    --   query search peer alice text "draft"
    --     -> SearchQuery {
    --          op       = execute,
    --          dn       = "private:alice",
    --          field    = "body",
    --          value    = "draft",
    --          criteria = like,
    --          type     = message
    --        }
    --
    --   query search group room1 text "draft"
    --     -> SearchQuery {
    --          op       = execute,
    --          dn       = "group:room1",
    --          field    = "body",
    --          value    = "draft",
    --          criteria = like,
    --          type     = message
    --        }
    --
    -- Тобто dn у search semantics є anchor / container scope
    -- для backend LDAP query, а не обов'язково literal user-facing DN.
    --
    --   query search field tag equal "release"
    --     -> SearchQuery {
    --          op       = execute,
    --          field    = "tag",
    --          value    = "release",
    --          criteria = equal,
    --          type     = message
    --        }
    --
    --   query search peer alice field body like "draft" return body tag
    --     -> SearchQuery {
    --          op       = execute,
    --          dn       = "private:alice",
    --          field    = "body",
    --          value    = "draft",
    --          criteria = like,
    --          type     = message,
    --          fields   = { "body", "tag" }
    --        }
    --
    -- Projection / pagination:
    --
    --   * Query.limit задає розмір search page.
    --
    --   * Query.continue або SearchAnswer.continue
    --     використовуються для pagination / continue semantics.
    --
    --   * requested projection fields задаються в SearchQuery.fields.
    --
    -- SearchItem зберігає LDAP/backend shape,
    -- але може також нести chat-facing projected message view.
    --
    -- Якщо type = message:
    --
    --   * payload MAY містити тільки requested visible fields
    --   * hidden fields MUST NOT з'являтися у payload
    --   * requested hidden fields повинні silently omitted
    --
    --   * field-level visibility має пріоритет для searchable/projection fields
    --
    --   * якщо field visibility для конкретного field відсутня,
    --     застосовується coarse message-level visibility/classification
    --
    SearchItem ::= SEQUENCE {
       dn        [0] Binary OPTIONAL,
       field     [1] Binary OPTIONAL,
       value     [2] Binary OPTIONAL,
       criteria  [3] Criteria OPTIONAL,
       type      [4] Scope OPTIONAL,

       -- optional chat-facing projection for message search
       messageId [5] Binary OPTIONAL,
       feed      [6] MessageFeed OPTIONAL,
       payload   [7] ContentInfo OPTIONAL,
       ...
    }

    SearchItem ::= SEQUENCE {
       dn       [0] Binary OPTIONAL,
       field    [1] Binary OPTIONAL,
       value    [2] Binary OPTIONAL,
       criteria [3] Criteria OPTIONAL,
       type     [4] Scope OPTIONAL
    }
    -- TODO:
    --   * вирішити, чи SearchItem лишається суто LDAP/backend-shaped
    --     result item
    --
    --   * якщо chat clients потребуватимуть richer search result,
    --     потрібно окремо визначити projection form
    --     для message-like search item
    --
    --   * у такому разі треба явно описати mapping:
    --       backend LDAP result -> chat-facing search view item

    -- result повертає список знайдених елементів (може бути пустим)
    SearchAnswer ::= SEQUENCE {
       items     [0] SEQUENCE OF item SearchItem OPTIONAL,
       continue  [1] Continuation OPTIONAL,
       hasMore   [2] BOOLEAN OPTIONAL,
       ...
    }

    -- Search semantics
    --
    --   * Search не змінює Message state
    --   * Search не означає read
    --   * Search не рухає replay cursor
    --   * Search не генерує окремих Event
    --
    --   * Search result є projection/view над існуючим state
    --     і не є окремим feed або event stream
    --
    --   * Group-scoped search допускається тільки для member / owner
    --
    --   * Якщо actor не має доступу до group scope,
    --     server SHOULD повертати Query error forbidden
    --
    --   * Якщо actor має group-scoped moderation restriction,
    --     server SHOULD повертати Query error forbidden
    --
    --   * Global search не повинен leak-ати inaccessible scope
    --     через result items
    --
    -- Field / visibility semantics:
    --
    --   * hidden field => not searchable
    --
    --   * requested hidden field => omitted from projected result
    --
    --   * field-level visibility MAY бути точнішою,
    --     ніж coarse message classification
    --
    --   * якщо для field задано explicit visibility policy,
    --     саме вона визначає searchable / projected visibility цього field
    --
    --   * якщо explicit field visibility відсутня,
    --     використовується message-level visibility/classification
    --
    -- Projection semantics:
    --
    --   * SearchQuery.fields MAY обмежувати projected result fields
    --
    --   * Якщо SearchQuery.fields відсутній,
    --     server MAY повернути default visible payload projection
    --
    -- Pagination semantics:
    --
    --   * Query.limit задає page size для SearchAnswer.items
    --
    --   * continue / hasMore працюють так само,
    --     як для інших snapshot/view query
    --
    --   * Search pagination не змінює read state
    --     і не впливає на replay boundary
    --
    SearchExtension ::= CHOICE {
       request [1] SearchQuery,
       result  [2] SearchAnswer
    }

    -- 06 Subscription (зв'язок підписки між суб'єктом і ціллю)
    --
    -- Модель спрощена до факту зв'язку (actor -> target).
    -- Жодних статусів або presence тут більше немає.
    --
    -- Перенесення семантики:
    --
    -- Presence (online/offline/typing):
    --   → перенесено в Event
    --
    -- Lifecycle дії (request/confirm/ignore/ban/unban):
    --   → передаються через Event (як події)
    --   → або ініціюються через Query (type=set)
    --
    -- Бан:
    --   → не є частиною Subscription
    --   → є server-side policy (обмеження доступу)
    --   → встановлюється через Query і сигналізується через Event
    --
    -- Таким чином:
    --   Subscription = state (факт зв'язку)
    --   Event        = що сталося (події)
    --   Query        = як це змінити / отримати
    --
    -- P2P Relation Semantics
    --
    --   * Subscription описує directed relation:
    --
    --       actor -> target
    --
    --   * Це базова relation model для p2p / contact semantics.
    --
    --   * Subscription не є самим roster, а є джерелом relation state,
    --     який MAY відображатись у roster/view.
    --
    --   * Mutual relation виникає як дві незалежні directed relation:
    --
    --       alice -> bob
    --       bob   -> alice
    --
    --   * Протокол не вимагає, щоб relation була mutual.
    --
    --   * One-way relation є валідною і не повинна автоматично
    --     створювати зворотний зв'язок.
    --
    -- Usage:
    --
    --   * Subscription MAY використовуватись для:
    --       - roster inclusion / contact visibility
    --       - presence visibility
    --       - optional trust / encryption policy
    --
    --   * Точна policy семантика relation не є частиною базового протоколу
    --     і визначається серверною реалізацією.
    --
    -- Direct Messaging:
    --
    --   * У базовій моделі direct private messaging не залежить
    --     від наявності Subscription або roster entry.
    --
    --   * Сервер MAY додати relation-gated messaging policy у майбутньому,
    --     але така policy повинна бути явно оголошена,
    --     а не випливати неявно з roster model.
    --
    -- Moderation interaction:
    --
    --   * Moderation policy є окремою від Subscription.
    --
    --   * Наявність Subscription не скасовує moderation restriction.
    --
    --   * Наявність moderation restriction не означає автоматичне
    --     видалення Subscription relation.

    -- XMPP відповідність:
    --
    --   subscription (actor → target):
    --     → RFC 3921 (Roster + Presence Subscriptions)
    --
    -- Зауваження:
    --
    --   У XMPP subscription і presence lifecycle змішані.
    --   У даному протоколі:
    --     - Subscription = лише факт зв'язку
    --     - Lifecycle події → Event
    --     - Команди → Query
    --

    Subscription ::= SEQUENCE {
       actor  Binary,
       target Binary,
       ...
    }

    -- get/create/remove очікують actor + target
    -- list допускає частковий фільтр
    --
    -- Inspection semantics:
    --
    --   * get використовується для inspection directed relation:
    --
    --       actor -> target
    --
    --   * list використовується для отримання relation set
    --     у межах actor filter.
    --
    --   * Якщо actor не вказаний явно,
    --     він MAY бути виведений із поточного authenticated session context.
    --
    SubscriptionQuery ::= SEQUENCE {
       op     SubscriptionOp,
       actor  [0] Binary OPTIONAL,
       target [1] Binary OPTIONAL,
       ...
    }

    SubscriptionOp ::= ENUMERATED {
       get    (1),
       list   (2),
       create (3),
       remove (4),
       ...
    }

    -- get/create/remove зазвичай повертають item
    -- list повертає items
    --
    --   * item означає один directed relation state
    --   * items означає список directed relation state
    --     для поточного actor/query context
    --
    SubscriptionAnswer ::= SEQUENCE {
       item   [0] Subscription OPTIONAL,
       items  [1] SEQUENCE OF subscription Subscription OPTIONAL,
       ...
    }

    -- 07 Roster (LDAP /People, /Channels, /Topics and /Servers user sub-folders)

    -- Presence як snapshot-стан для roster/member.
    -- Runtime presence-події (online/offline/typing) передаються через Event.

    Presence ::= ENUMERATED { offline (1), online (2), ... }

    PresenceOp ::= ENUMERATED {
       get  (1),
       list (2), ...
    }

    -- get зазвичай очікує actor
    -- list допускає actor і/або feed як фільтр вибірки
    -- feed задає контекст (якщо presence залежить від feed)
    PresenceQuery ::= SEQUENCE {
       op     PresenceOp,
       actor  [0] Binary OPTIONAL,
       feed   [1] MessageFeed OPTIONAL,
       ...
    }

    PresenceItem ::= SEQUENCE {
       actor     Binary,
       presence  Presence
    }

    -- get зазвичай повертає item
    -- list повертає items (може бути пустим)
    PresenceAnswer ::= SEQUENCE {
       item   [0] PresenceItem OPTIONAL,
       items  [1] SEQUENCE OF item PresenceItem OPTIONAL,
       ...
    }


    -- PersonStatus описує лише стан самого profile/state запису.
    -- Relation, lifecycle і moderation більше не живуть у Person:
    --   req/auth/ignore/friend -> Subscription / Event
    --   ban/banned             -> ModerationQuery / Event
    PersonStatus ::= ENUMERATED {
       active      (1),
       deleted     (2),
       nonexistent (3), ...
    }

    -- lastmsg не є частиною Person state.
    -- View-дані повинні передаватися через Query (Inbox/Search) або Event.
    Person ::= SEQUENCE {
       id Binary,
       nickname Binary,
       avatar Binary,
       names SEQUENCE OF name Binary,
       phone Binary,
       surnames SEQUENCE OF name Binary,
       presence Presence,
       update INTEGER,
       created INTEGER,
       settings SEQUENCE OF feature Feature OPTIONAL,
       status PersonStatus,
       ...
    }

    PersonOp ::= ENUMERATED {
       get    (1),
       list   (2),
       update (3),
       remove (4), ...
    }

    -- get/remove очікують id
    -- update використовує поля профілю
    -- list допускає частковий фільтр

    PersonQuery ::= SEQUENCE {
       op   PersonOp,

       id   [0] Binary OPTIONAL,
       name [1] Binary OPTIONAL,
       ...
    }

    PersonItem ::= SEQUENCE {
       id       Binary,
       nickname Binary,
       presence Presence,
       status   PersonStatus
    }

    -- get/update зазвичай повертають item
    -- list повертає items

    PersonAnswer ::= SEQUENCE {
       item   [0] PersonItem OPTIONAL,
       items  [1] SEQUENCE OF item PersonItem OPTIONAL,
       ...
    }

    Server ::= SEQUENCE { service Binary, port INTEGER, host Binary }

    -- RosterStatus описує лише стан roster як ресурсу.
    -- Command, mutation і lookup більше не живуть у Roster:
    --   get/create/del/remove/add/update/list/patch -> Query
    --   nick/search/contact/lastmsg                 -> Query / view

    RosterStatus ::= ENUMERATED {
       active   (1),
       archived (2),
       deleted  (3), ...
    }

    -- Roster є агрегованим snapshot/view ресурсом.
    -- Операції над roster передаються через Query.
    -- Runtime-події не живуть у Roster як моделі.
    --
    -- Roster / Relation Semantics
    --
    --   * Roster є snapshot/view ресурсом, а не джерелом істини
    --     для p2p relation або messaging authorization.
    --
    --   * Видимість contact у roster SHOULD походити з relation state
    --     (наприклад Subscription), а не навпаки.
    --
    --   * Add/remove у roster semantics слід інтерпретувати як зміну
    --     roster-visible relation state, а не як transport-level дозвіл
    --     або заборону direct messaging.
    --
    --   * Direct private messaging у базовій моделі MAY існувати
    --     без roster entry.
    --
    --   * Видалення contact з roster саме по собі не повинно
    --     автоматично блокувати direct messaging, якщо окрема server policy
    --     не визначає інше.
    --
    --   * Якщо сервер підтримує relation-gated messaging,
    --     ця policy повинна бути явно зафіксована окремо.

    -- XMPP відповідність:
    --
    --   roster:
    --     → RFC 3921 (Roster Management)
    --
    -- Зауваження:
    --
    --   У даному протоколі roster є snapshot/view ресурсом,
    --   а не джерелом runtime-подій.
    --

    Roster ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       nickname Binary,
       keys SEQUENCE OF key Binary,
       people SEQUENCE OF contact Person,
       topics SEQUENCE OF room Conference,
       channels SEQUENCE OF room Conference,
       servers SEQUENCE OF server Server,
       update INTEGER,
       status RosterStatus, ... }

    RosterOp ::= ENUMERATED {
       get  (1),
       list (2), ...
    }
    -- TODO:
    --   Уточнити, чи roster має власні mutation operations
    --   (add/remove/update), чи ці дії є лише projection
    --   над relation model (наприклад Subscription).
    --
    --   Поточна preferred model:
    --     - relation state живе окремо
    --     - roster є snapshot/view цього state

    -- get зазвичай очікує id
    -- list допускає частковий фільтр
    --
    -- TODO:
    --   Якщо буде підтримано явні roster mutations,
    --   потрібно визначити:
    --
    --     * чи це локальна address-book дія
    --     * чи це зміна directed relation
    --     * чи впливає вона на visibility для іншої сторони
    --
    --   До цього моменту roster слід трактувати як view/query layer.
    --
    RosterQuery ::= SEQUENCE {
       op   RosterOp,
       id   [0] Binary OPTIONAL,
       name [1] Binary OPTIONAL,
       ...
    }

    RosterItem ::= SEQUENCE {
       id       Binary,
       nickname Binary,
       status   RosterStatus
    }

    -- get зазвичай повертає item
    -- list повертає items
    RosterAnswer ::= SEQUENCE {
       item      [0] RosterItem OPTIONAL,
       items     [1] SEQUENCE OF item RosterItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL,
       ...
    }

    RosterCore ::= CHOICE {
       request [1] RosterQuery,
       result  [2] RosterAnswer
    }

    -- Moderation / Policy Semantics
    --
    --   * Moderation є окремим policy layer,
    --     а не relation state і не roster view.
    --
    --   * ban створює policy restriction для actor -> target.
    --
    --   * unban видаляє цю policy restriction.
    --
    --   * list повертає moderation restrictions для поточного actor
    --     або для явно заданого actor filter.
    --
    --   * Moderation не повинна неявно змінювати Subscription або Roster.
    --
    --   * Timing semantics для ban/unban визначається загальними
    --     правилами Query / Command Evaluation Semantics.
    --
    ModerationOp ::= ENUMERATED {
       ban    (1),
       unban  (2),
       list   (3), ...
    }

    -- ban/unban очікують actor + target
    -- list повертає список обмежень
    --
    -- Semantics:
    --
    --   * actor є джерелом policy restriction
    --   * target є суб'єктом, до якого застосовується restriction
    --
    --   * Якщо actor не вказаний явно,
    --     він MAY бути виведений із поточного authenticated session context.
    --
    --   * ban/unban не повинні змінювати Subscription або Roster напряму.
    --
    ModerationQuery ::= SEQUENCE {
       op     ModerationOp,
       actor  [0] Binary OPTIONAL,
       target [1] Binary OPTIONAL,
       ...
    }

    ModerationItem ::= SEQUENCE {
       actor   Binary,
       target  Binary
    }

    -- ban/unban зазвичай повертають item
    -- list повертає items
    --
    --   * item означає конкретну moderation restriction
    --   * items означає snapshot/list moderation restrictions
    --     у межах поточного query context
    --
    ModerationAnswer ::= SEQUENCE {
       item   [0] ModerationItem OPTIONAL,
       items  [1] SEQUENCE OF item ModerationItem OPTIONAL,
       ...
    }

    ModerationExtension ::= CHOICE {
       request [1] ModerationQuery,
       result  [2] ModerationAnswer
    }

    -- 08 Conference (RocksDB, Multi-user Conferences)

    -- MemberStatus описує лише роль учасника в конференції.
    -- Lifecycle і mutation більше не живуть у Member:
    --   removed        -> Event / Query
    --   patch/update   -> Query
    MemberStatus ::= ENUMERATED {
       member (1),
       admin  (2),
       owner  (3), ...}

    -- Role Semantics
    --
    --   * owner має всі права member щодо доступу до group feed.
    --
    --   * admin/member policy може деталізуватись сервером,
    --     але базовий доступ до group feed дозволяється всім valid members.

    Member ::= SEQUENCE {
       id Binary,
       nickname Binary,
       feed MessageFeed,
       feeds SEQUENCE OF feed Binary,
       phone Binary,
       avatar Binary,
       names SEQUENCE OF name Binary,
       surnames SEQUENCE OF name Binary,
       alias Binary,
       update INTEGER,
       settings SEQUENCE OF feature Feature,
       presence Presence,
       status MemberStatus, ... }

    MemberOp ::= ENUMERATED {
       get    (1),
       list   (2),
       add    (3),
       remove (4),
       update (5)
    }

    -- get/remove/update очікують actor + feed
    -- add використовує actor + feed
    -- list допускає фільтр за feed
    --
    -- Group Membership Semantics
    --
    --   * Member є джерелом істини для membership у Conference/group feed.
    --
    --   * add створює membership relation:
    --
    --       actor -> group feed
    --
    --   * remove видаляє membership relation.
    --
    --   * owner Conference також вважається валідним member
    --     для доступу до group feed.
    --
    --   * Timing semantics для add/remove визначається загальними
    --     правилами Query / Command Evaluation Semantics.
    --
    MemberQuery ::= SEQUENCE {
       op    MemberOp,

       actor [0] Binary OPTIONAL,
       feed  [1] MessageFeed OPTIONAL
    }

    MemberItem ::= SEQUENCE {
       actor   Binary,
       feed    MessageFeed,
       status  MemberStatus,
       presence Presence OPTIONAL
    }

    -- get/add/update зазвичай повертають item
    -- list повертає items

    MemberAnswer ::= SEQUENCE {
       item      [0] MemberItem OPTIONAL,
       items     [1] SEQUENCE OF item MemberItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL
    }

    ConferenceType ::= ENUMERATED { group (1), channel (2), call (3) }

    -- ConferenceStatus описує лише стан конференції як ресурсу.
    -- Command, lifecycle і події більше не живуть у Conference:
    --   create/add/remove/patch/get/delete -> Query
    --   join/leave/joined/removed          -> Event
    --   mute/unmute                        -> Query / Event
    --   lastmsg                            -> Query (Inbox/Search) або Event

    -- XMPP відповідність:
    --
    --   conference / group / channel:
    --     → XEP-0045 (Multi-User Chat)
    --
    -- Зауваження:
    --
    --   У XMPP багато логіки зашито в stanza.
    --   Тут модель розділена:
    --     - Conference = state
    --     - Event = runtime події
    --     - Query = команди
    --

    ConferenceStatus ::= ENUMERATED {
       active   (1),
       archived (2),
       deleted  (3), ...
    }

    -- Conference / Group Model
    --
    --   * Conference описує існування і стан group ресурсу.
    --
    --   * MessageFeed.group є message stream цієї conference.
    --
    --   * Membership і доступ до group feed не є implicit полями Conference,
    --     а визначаються через Member relation і server-side authorization.
    --
    --   * unread / mention-derived дані належать до feed view layer,
    --     а не до canonical Conference state.
    --
    --   * lastmsg також не є частиною Conference state.
    --
    Conference ::= SEQUENCE {
       id Binary,
       vsn Version,
       session Binary,
       name Binary,
       links SEQUENCE OF link Binary,
       description Binary,
       settings SEQUENCE OF feature Feature,
       members SEQUENCE OF member Member,
       admins SEQUENCE OF member Member,
       data SEQUENCE OF fileId Binary OPTIONAL,
       type ConferenceType,
       tos Binary,
       update INTEGER,
       created INTEGER,
       status ConferenceStatus,
        ... }

    ConferenceOp ::= ENUMERATED {
       get     (1),
       list    (2),
       create  (3),
       update  (4),
       remove  (5), ...
    }

    -- get/remove очікують id
    -- create/update використовують поля конференції
    -- list допускає частковий фільтр
    --
    -- Group Lifecycle Semantics
    --
    --   * Conference є canonical state ресурсом для group.
    --
    --   * Conference(type=group) створює group resource,
    --     з яким пов'язаний MessageFeed.group.
    --
    --   * Creator Conference автоматично стає:
    --       - owner
    --       - і валідним member цієї group
    --
    --   * Membership інших користувачів керується через MemberQuery.add/remove,
    --     а не через окрему mutation semantics усередині Conference.
    --
    --   * Видалення Conference робить відповідний group feed недоступним.
    --
    --   * Timing semantics для create/update/remove визначається
    --     загальними правилами Query / Command Evaluation Semantics.
    --
    ConferenceQuery ::= SEQUENCE {
       op    ConferenceOp,
       id    [0] Binary OPTIONAL,
       name  [1] Binary OPTIONAL,
       type  [2] ConferenceType OPTIONAL,
       ...
    }

    -- get/create/update зазвичай повертають item
    -- list повертає items

    ConferenceAnswer ::= SEQUENCE {
       item      [0] ConferenceItem OPTIONAL,
       items     [1] SEQUENCE OF item ConferenceItem OPTIONAL,
       continue  [2] Continuation OPTIONAL,
       hasMore   [3] BOOLEAN OPTIONAL,
       ...
    }

    ConferenceItem ::= SEQUENCE {
       id    Binary,
       name  Binary,
       type  ConferenceType,
       status ConferenceStatus
    }

    ConferenceExtension ::= CHOICE {
       request [1] ConferenceQuery,
       result  [2] ConferenceAnswer
    }

    -- 09 CHAT-v2 Protocol Entities
    -- Server Invariants / Guarantees
    --
    -- Delivery Model:
    --
    --   * Message і Event доставляються за моделлю at-least-once.
    --
    --   * Повторна доставка можлива після retry або reconnect.
    --
    --   * Клієнт повинен бути ідемпотентним.
    --
    -- Ordering:
    --
    --   * Порядок гарантується тільки в межах одного feed.
    --
    --   * seq є монотонно зростаючим у межах feed.
    --
    --   * Глобальний порядок між feed не гарантується.
    --
    -- Replay:
    --
    --   * Сервер може відтворювати події через EventQuery (after).
    --
    --   * Replay гарантує тільки часткове відновлення (partial recovery).
    --
    -- Retention:
    --
    --   * Сервер може обмежувати історію подій (retention policy).
    --
    --   * Події можуть бути втрачені (gap).
    --
    -- Gap Handling:
    --
    --   * У випадку gap сервер сигналізує через:
    --
    --       Query(type=error, code=gap)
    --
    --   * Клієнт повинен виконати повний sync через snapshot (Inbox).
    --
    -- Consistency:
    --
    --   * causal ordering не гарантується.
    --
    --   * Conflict resolution:
    --       - last-write-wins (timestamp)
    --       - delete має пріоритет над edit/update
    --
    -- Session:
    --
    --   * Session є незалежною одиницею доставки.
    --
    --   * Кожна session має власний:
    --      - last_seq
    --
    --   * read cursor є логічно user-scoped:
    --      - server підтримує effective read cursor(user, feed)
    --
    --   * session може мати локальний технічний стан,
    --     але не є джерелом істини для read/unread
    --
    --   * Сервер не веде окремі event-черги на session.
    --
    -- Federation:
    --
    --   * Authoritative broker відповідає за порядок і seq у feed.
    --
    --   * Проміжні broker не змінюють payload.
    --
    -- Conflict / Race Semantics
    --
    --   * Protocol не гарантує serializable snapshot між commands і view queries.
    --
    --   * Policy/resource changes (ban, membership remove, conference delete)
    --     можуть відбуватись між snapshot і наступною command.
    --
    --   * already accepted command зберігає свій ефект,
    --     якщо інше явно не визначено окремою policy.
    --
    --   * new command після зміни state оцінюється
    --     за актуальним server state.
    --
    -- Snapshot vs Stream:
    --
    --   * Event (seq) → streaming модель (log).
    --
    --   * Query (continuation) → snapshot/view модель.
    --
    --   * Консистентність між ними не гарантується.

    CHATProtocol ::= CHOICE {
       authority [1] Authority,
       message   [2] Message,
       event     [4] Event,
       query     [5] Query
    }

    -- Transport Batching / Framing
    --
    --   * Транспортний контейнер може нести:
    --       - один пакет протоколу
    --       - або batch з кількох пакетів
    --
    --   * Batching використовується для:
    --       - зменшення transport overhead
    --       - групування дрібних Event/Query/Message
    --
    --   * Порядок елементів у batch зберігається.
    --
    --   * Batch є transport-оптимізацією і не змінює семантику
    --     окремих Message/Event/Query.
    CHATBody ::= CHOICE {
       single [1] CHATProtocol,
       batch  [2] SEQUENCE OF packet CHATProtocol
    }

    -- Security / Trust Boundaries
    --
    --   * TLS захищає transport channel між сусідніми вузлами,
    --     але не гарантує end-to-end недоторканність payload.
    --
    -- Trust Model:
    --
    --   * Клієнт довіряє authoritative broker/server тільки в межах:
    --       - routing
    --       - auth/session validation
    --       - replay / retention policy
    --
    --   * Проміжні broker в federation вважаються transport-trusted,
    --     але не payload-trusted.
    --
    -- Mutable by broker:
    --
    --   * headers
    --   * routing metadata
    --   * tracing metadata
    --
    -- Not mutable by broker:
    --
    --   * Message.payload
    --   * Event.payload
    --   * Query.payload
    --
    --   * Проміжні broker не повинні змінювати domain payload,
    --     навіть якщо вони форвардять пакет.
    --
    -- Token Handling:
    --
    --   * accessToken є transport credential і може перевірятись
    --     broker/server вузлом, який термінує transport session.
    --
    --   * refreshToken не повинен передаватись поза auth flow
    --     (Authority.authenticate / Authority.renew).
    --
    -- End-to-End Security:
    --
    --   * Якщо потрібна end-to-end цілісність або конфіденційність,
    --     вона повинна забезпечуватись на рівні payload
    --     (поза межами базового transport протоколу).
    --
    -- Transport headers
    --
    --   * headers можуть містити:
    --       - accessToken
    --       - routing metadata
    --       - tracing / delivery metadata
    --
    --   * accessToken використовується для авторизації конкретної session
    --     на transport рівні.
    Header ::= CHOICE {
       auth      [1] AuthHeader,
       routing   [2] RoutingHeader,
       tracing   [3] TracingHeader,
       ...
    }

    AuthHeader ::= SEQUENCE {
       accessToken Binary
    }

    -- Routing / Federation Semantics
    --
    --   * RoutingHeader використовується для transport-level маршрутизації
    --     між broker/server вузлами.
    --
    --   * target є optional routing hint для адресації кінцевого ресурсу
    --     або вузла призначення.
    --
    --   * feed задає логічний контекст маршрутизації повідомлення.
    --
    -- Authority:
    --
    --   * Для кожного feed існує authoritative broker/server,
    --     який відповідає за:
    --       - порядок подій у feed
    --       - seq у межах feed
    --       - retention / replay policy
    --
    -- Federation:
    --
    --   * Проміжні broker MAY форвардити пакети до authoritative вузла
    --     або до наступного маршруту.
    --
    --   * Проміжні broker не повинні змінювати семантику payload.
    --
    --   * Проміжні broker MAY додавати transport metadata у headers,
    --     але не повинні змінювати Message/Event/Query payload.
    --
    -- Ordering:
    --
    --   * Порядок подій гарантується тільки authoritative вузлом feed.
    --
    --   * Federation не гарантує глобальний порядок між різними feed
    --     або різними маршрутами.
    --
    -- Error Handling:
    --
    --   * Якщо маршрут невідомий або недоступний,
    --     сервер SHOULD повертати Query(type=error, code=notFound)
    --     або Query(type=error, code=unavailable).

    RoutingHeader ::= SEQUENCE {
       target [0] Binary OPTIONAL,
       feed   [1] MessageFeed OPTIONAL,
       broker [2] Binary OPTIONAL,
       ...
    }

    TracingHeader ::= SEQUENCE {
       traceId [0] Binary OPTIONAL,
       spanId  [1] Binary OPTIONAL,
       ...
    }

    CHATMessage ::= SEQUENCE {
       no INTEGER,
       headers SEQUENCE OF header Header,
       body CHATBody }

END